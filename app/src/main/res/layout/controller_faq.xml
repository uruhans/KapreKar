<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

  <data>
    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.guides.faq.FaqController" />
  </data>

  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/toolbar_height">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_larger"
        android:text="@string/guides_faq_title"
        style="@style/TextStyle.Coloplast.Bold.DarkGrey.32" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_larger"
        android:layout_marginTop="@dimen/spacing_small"
        android:text="@string/guides_faq_description"
        style="@style/TextStyle.Coloplast.Regular.ClearGrey.30" />

  <!--    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardUseCompatPadding="true"
        android:orientation="vertical"
        app:itemBinding="@{controller.itemBinding}"
        app:items="@{controller.items}"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />-->


    </LinearLayout>

  </ScrollView>
</layout>