<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>

    <variable
      name="item"
      type="com.coloplast.olympus.ui.feature.onboarding.setup.model.NumberedCard" />
  </data>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="match_parent"
      android:layout_marginStart="@dimen/spacing_double"
      android:gravity="center_vertical"
      android:orientation="vertical">

      <ImageView
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal"
        android:layout_weight="1"
        app:tintDrawable="@{item.firstLineColor}"
        app:visibleOrInvisible="@{!item.isFirst}"
        android:src="@drawable/vertical_line" />

      <ImageView
        android:layout_width="8dp"
        android:layout_height="8dp"
        app:tintDrawable="@{item.dotColor}"
        android:src="@drawable/dot" />

      <ImageView
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal"
        android:layout_weight="1"
        app:tintDrawable="@{item.secondLineColor}"
        app:visibleOrInvisible="@{!item.isLast}"
        android:src="@drawable/vertical_line" />

    </LinearLayout>
    
    <androidx.cardview.widget.CardView
      android:id="@+id/cardView"
      style="@style/CardViewStyle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/spacing_half"
      android:layout_marginTop="@dimen/spacing_half"
      android:layout_marginStart="@dimen/spacing_double"
      android:layout_marginEnd="@dimen/spacing_larger"
      android:clickable="true"
      android:focusable="true"
      android:foreground="@{item.enabled ? @drawable/empty : @drawable/cardview_disabled_foreground}">

      <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="72dp">

        <TextView
          android:id="@+id/name"
          style="@style/Headline.Small"
          android:layout_width="wrap_content"
          android:layout_height="match_parent"
          android:layout_marginStart="@dimen/spacing_larger"
          android:gravity="center_vertical"
          android:text="@{item.textRes}"
          android:textColor="@color/darkGrey01"
          android:textSize="@dimen/text_20"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          tools:text="1. introduction" />

      </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

  </LinearLayout>
</layout>