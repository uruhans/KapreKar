<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.onboarding.signup.dataconsent.dc5.AcceptTermsDC5Controller" />
  </data>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginStart="@dimen/spacing_standard"
    android:layout_marginEnd="@dimen/spacing_standard"
    android:orientation="vertical">

    <ImageView
      android:id="@+id/ic_agree_terms"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:contentDescription="@string/onboarding_dc5_title"
      android:src="@drawable/ic_agree_terms" />

    <TextView
      android:id="@+id/title"
      style="@style/TextStyle.Coloplast.Bold.DarkGrey.24"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/spacing_standard"
      android:layout_marginBottom="@dimen/spacing_standard"
      android:text="@string/onboarding_dc5_title" />

    <Button
      android:id="@+id/policy_agreement_button"
      style="@style/Button.Borderless"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/spacing_standard"
      android:onClick="@{() -> controller.onPolicyAgreementClicked()}"
      android:text="@string/onboarding_dc5_link1_text"
      android:textAlignment="textStart"
      android:textAllCaps="false"
      android:textSize="@dimen/text_18" />

    <androidx.cardview.widget.CardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@drawable/cardview_not_selected"
      app:cardCornerRadius="@dimen/cardview_corner_radius"
      app:cardElevation="@dimen/cardview_elevation_default"
      app:cardUseCompatPadding="true">

      <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginTop="@dimen/spacing_double"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:layout_marginBottom="@dimen/spacing_double">

        <TextView
          android:id="@+id/data_policy_card_title"
          style="@style/TextStyle.Coloplast.Bold.DarkGrey.24"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/onboarding_dc5_card_title"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.SwitchCompat
          android:id="@+id/data_policy_card_switch"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:checked="@={controller.dataPolicyAccepted}"
          app:layout_constraintBottom_toBottomOf="@id/data_policy_card_title"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Barrier
          android:id="@+id/barrier"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:barrierDirection="start"
          app:constraint_referenced_ids="data_policy_card_switch" />

        <TextView
          android:id="@+id/data_policy_card_description"
          style="@style/TextStyle.Roboto.Regular.ClearGrey.16"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/spacing_small"
          android:text="@string/onboarding_dc5_card_description"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toEndOf="@id/barrier"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/data_policy_card_switch" />

      </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <Button
      style="@style/Button"
      android:layout_width="match_parent"
      android:layout_marginStart="0dp"
      android:layout_marginTop="@dimen/spacing_double"
      android:layout_marginEnd="0dp"
      android:layout_marginBottom="@dimen/spacing_double"
      android:onClick="@{()-> controller.onContinueClicked()}"
      android:text="@string/generic_continue" />

  </LinearLayout>
</layout>