<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>
    <import type="com.coloplast.olympus.ui.feature.guides.models.ButtonType" />
    <variable
      name="item"
      type="com.coloplast.olympus.ui.feature.guides.articles.models.ButtonItem" />
  </data>

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <Button
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/spacing_standard"
      app:safeText="@{item.text}"
      android:onClick="@{() -> item.onButtonClicked()}"
      app:visibleOrGone="@{item.buttonType == ButtonType.ACTION}"
      style="@style/Button" />

    <Button
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/spacing_standard"
      app:safeText="@{item.text}"
      android:onClick="@{() -> item.onButtonClicked()}"
      app:visibleOrGone="@{item.buttonType == ButtonType.BACK}"
      style="@style/Button.Secondary" />

    <Button
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_margin="@dimen/spacing_standard"
      app:safeText="@{item.text}"
      android:onClick="@{() -> item.onButtonClicked()}"
      app:visibleOrGone="@{item.buttonType == ButtonType.LINK}"
      style="@style/Button.Borderless"
      android:textAllCaps="false"
      android:textAlignment="viewStart" />
  </FrameLayout>

