<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>
    <import type="com.coloplast.olympus.ui.common.extensions.GuidesMenuSubsectionKt" />
    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.guides.GuidesSubsectionController" />
  </data>

  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/toolbar_height">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <TextView
        style="@style/TextStyle.Coloplast.Bold.DarkGrey.32"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_larger"
        android:layout_marginEnd="@dimen/spacing_larger"
        app:safeText="@{GuidesMenuSubsectionKt.getTitle(controller.type)}" />

      <TextView
        style="@style/TextStyle.Roboto.Regular.ClearGrey.18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_larger"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/spacing_larger"
        app:safeText="@{GuidesMenuSubsectionKt.getDescription(controller.type)}" />

      <TextView
        style="@style/TextStyle.Roboto.Regular.ClearGrey.16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_larger"
        android:layout_marginTop="@dimen/spacing_standard"
        android:layout_marginEnd="@dimen/spacing_larger"
        android:layout_marginBottom="@dimen/spacing_half"
        app:safeText="@{GuidesMenuSubsectionKt.getListTitle(controller.type)}" />

      <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        app:itemBinding="@{controller.itemBinding}"
        app:items="@{controller.items}"
        app:nestedScrollingEnabled="@{false}"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>

  </androidx.core.widget.NestedScrollView>
</layout>