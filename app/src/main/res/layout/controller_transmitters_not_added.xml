<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>

    <variable
      name="toolbarSupport"
      type="com.coloplast.olympus.ui.common.ToolbarSupportController" />

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.transmitters.NotAddedTransmittersController" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <include
      android:id="@+id/toolbar"
      layout="@layout/view_toolbar"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:support="@{toolbarSupport}" />

    <TextView
      android:id="@+id/title"
      style="@style/Headline.Large"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:text="@string/transmitters_title"
      android:textColor="@color/darkGrey01"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <TextView
      android:id="@+id/address"
      style="@style/Text.Large"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:layout_marginTop="@dimen/spacing_small"
      android:textColor="@color/darkGrey03"
      android:text="@string/transmitters_no_transmitters_added_body"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/title" />

    <androidx.cardview.widget.CardView
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:layout_marginBottom="@dimen/spacing_double"
      android:foreground="?attr/selectableItemBackground"
      app:cardBackgroundColor="@color/olympus_bluegreen"
      android:onClick="@{() -> controller.onAddTransmitterClicked()}"
      app:cardCornerRadius="28dp"
      app:cardElevation="4dp"
      app:cardPreventCornerOverlap="true"
      app:cardUseCompatPadding="false"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent">

      <TextView
        style="@style/Text.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/transmitters_add_transmitter"
        android:textSize="18sp"
        android:textColor="@color/white"
        />

    </androidx.cardview.widget.CardView>



  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>

