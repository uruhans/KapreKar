<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>
    <variable
      name="toolbarSupport"
      type="com.coloplast.olympus.ui.common.ToolbarSupportController" />

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.guides.getstarted.GetStartedGuideController" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <include
      android:id="@+id/toolbar"
      layout="@layout/view_toolbar"
      app:support="@{toolbarSupport}" />

    <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/get_started_recyclerView"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginTop="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:layout_marginBottom="@dimen/spacing_half"
      app:itemBinding="@{controller.itemBinding}"
      app:items="@{controller.items}"
      app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
      app:layout_constraintBottom_toTopOf="@+id/accept_button"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <Button
      android:id="@+id/accept_button"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_margin="@dimen/spacing_standard"
      android:background="@drawable/button_color_accent"
      android:text="@string/guide_get_started"
      android:textAllCaps="false"
      android:textColor="@color/white"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent" />

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>