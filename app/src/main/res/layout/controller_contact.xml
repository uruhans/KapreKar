<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <variable
      name="toolbarSupport"
      type="com.coloplast.olympus.ui.common.ToolbarSupportController" />

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.contact.ContactController" />

  </data>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
      android:id="@+id/toolbar"
      layout="@layout/view_toolbar"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:support="@{toolbarSupport}" />

    <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/spacing_larger"
        android:layout_marginEnd="@dimen/spacing_larger"
        android:layout_marginBottom="@dimen/spacing_larger"
        android:paddingBottom="@dimen/spacing_larger">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/contact_cp_title"
          style="@style/TextStyle.Coloplast.Bold.DarkGrey.36"/>

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="@dimen/spacing_small"
          android:layout_marginTop="@dimen/spacing_double"
          android:text="@string/contact_cp_subtitle"
          style="@style/TextStyle.Roboto.Regular.ClearGrey.14" />
      </LinearLayout>
    </ScrollView>

  </LinearLayout>

</layout>