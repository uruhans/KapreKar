<?xml version="1.0" encoding="utf-8"?>
<layout>

  <data>
    <variable
      name="settingsClickListener"
      type="android.view.View.OnClickListener" />

    <variable
      name="sensorsClickListener"
      type="android.view.View.OnClickListener" />

    <variable
      name="ringingAlertsEnabled"
      type="Boolean" />
  </data>

  <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cardview_not_selected"
    app:cardCornerRadius="@dimen/cardview_corner_radius"
    app:cardElevation="@dimen/cardview_elevation_default"
    app:cardUseCompatPadding="true">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_larger"
      android:layout_marginTop="@dimen/spacing_larger"
      android:layout_marginEnd="@dimen/spacing_larger"
      android:layout_marginBottom="@dimen/spacing_small"
      android:orientation="vertical">

      <TextView
        style="@style/TextStyle.Coloplast.Bold.DarkGrey.24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:drawableStart="@drawable/ic_notifications"
        android:drawableTint="@color/black"
        android:drawablePadding="@dimen/spacing_half"
        android:text="@string/settings_sound_title" />

      <TextView
        style="@style/TextStyle.Roboto.Regular.ClearGrey.16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_small"
        android:text="@string/settings_sound_body" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/spacing_small"
        android:paddingBottom="@dimen/spacing_small"
        android:text="@string/settings_android_app_settings_link"
        style="@style/TextStyle.Roboto.Medium.Turquoise.18"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:onClick="@{settingsClickListener}"/>

      <include layout="@layout/item_recyclerview_section_divider" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
          style="@style/TextStyle.Coloplast.Bold.DarkGrey.24"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center_vertical"
          android:drawableStart="@drawable/ic_notifications"
          android:drawableTint="@color/black"
          android:drawablePadding="@dimen/spacing_half"
          android:text="@string/settings_sounds_ringing_alerts_title" />

        <Switch
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_weight="0"
          android:checked="@={ringingAlertsEnabled}" />

      </LinearLayout>

      <TextView
        style="@style/TextStyle.Roboto.Regular.ClearGrey.16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_small"
        android:text="@string/settings_sounds_ringing_alerts_body" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/spacing_small"
        android:paddingBottom="@dimen/spacing_small"
        android:text="@string/settings_sounds_ringing_alerts_link"
        style="@style/TextStyle.Roboto.Medium.Turquoise.18"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:onClick="@{sensorsClickListener}"/>



    </LinearLayout>

  </androidx.cardview.widget.CardView>

</layout>


