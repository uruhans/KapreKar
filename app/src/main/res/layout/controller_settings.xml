<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.settings.SettingsController" />

  </data>

  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/toolbar_height">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:layout_marginStart="@dimen/spacing_larger"
      android:layout_marginEnd="@dimen/spacing_larger"
      android:layout_marginBottom="@dimen/spacing_larger"
      android:paddingBottom="@dimen/spacing_larger">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        style="@style/TextStyle.Coloplast.Bold.DarkGrey.36"/>

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_small"
        android:layout_marginTop="@dimen/spacing_double"
        android:text="@string/settings_notifications_section_title"
        style="@style/TextStyle.Roboto.Regular.ClearGrey.14" />

      <include layout="@layout/item_notification_settings_card"
        app:buttonClickListener="@{() -> controller.openAppSettings()}"/>

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_small"
        android:layout_marginTop="@dimen/spacing_double"
        android:text="@string/settings_vibration_section_title"
        style="@style/TextStyle.Roboto.Regular.ClearGrey.14" />

      <include layout="@layout/item_vibration_settings_card"
        app:buttonClickListener="@{() -> controller.openAppSettings()}"/>

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_small"
        android:layout_marginTop="@dimen/spacing_double"
        android:text="@string/settings_sounds_section_title"
        style="@style/TextStyle.Roboto.Regular.ClearGrey.14" />

      <include layout="@layout/item_sound_settings_card"
        app:settingsClickListener="@{() -> controller.openAppSettings()}"
        app:sensorsClickListener="@{() -> controller.chooseSensors()}"
        app:ringingAlertsEnabled="@={controller.ringingAlertsEnabled}"/>

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_small"
        android:layout_marginTop="@dimen/spacing_double"
        android:text="@string/settings_bedtime_alerts_section_title"
        style="@style/TextStyle.Roboto.Regular.ClearGrey.14" />

      <include layout="@layout/item_bedtime_alarm_card"
        app:buttonClickListener="@{() -> controller.setBedtimeAlarmClicked()}"/>

    </LinearLayout>
  </ScrollView>

</layout>