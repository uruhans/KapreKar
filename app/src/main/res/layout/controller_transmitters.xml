<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>

    <variable
      name="toolbarSupport"
      type="com.coloplast.olympus.ui.common.ToolbarSupportController" />

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.transmitters.TransmittersController" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <include
      android:id="@+id/toolbar"
      layout="@layout/view_toolbar"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:support="@{toolbarSupport}" />

    <TextView
      android:id="@+id/headline"
      style="@style/Headline.Large"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:text="@string/transmitters_title"
      android:textColor="@color/darkGrey01"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <TextView
      android:id="@+id/button_edit"
      style="@style/Text.Medium"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:fontFamily="sans-serif-medium"
      android:text="[Edit]"
      android:textColor="@color/colorAccent"
      android:textSize="@dimen/text_18"
      app:layout_constraintBottom_toBottomOf="@+id/headline"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="@+id/headline"
      app:visibleOrInvisible="@{controller.hasTransmittersAdded}" />

    <include
      layout="@layout/state_no_transmitters"
      android:layout_width="0dp"
      android:layout_height="0dp"
      app:controller="@{controller}"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/headline"
      app:visibleOrGone="@{!controller.hasTransmittersAdded}" />

    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/layout_transmitters_added"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:orientation="vertical"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/headline"
      app:visibleOrGone="@{controller.hasTransmittersAdded}"
      tools:visibility="gone">

      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_standard"
        android:background="@color/white"
        app:itemBinding="@{controller.itemBinding}"
        app:items="@{controller.items}"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

      <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginBottom="78dp"
        android:background="#f5f5f5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

      <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginStart="@dimen/spacing_half"
        android:layout_marginBottom="43dp"
        android:alpha="0.16"
        android:scaleX="0.7"
        android:scaleY="0.7"
        android:src="@drawable/transmitter_fab"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:visibleOrInvisible="@{false}" />

      <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floating_action_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginBottom="51dp"
        android:cropToPadding="false"
        android:tint="@color/colorAccent"
        app:backgroundTint="@color/white"
        app:borderWidth="0dp"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_bluetooth_black_24dp"
        app:visibleOrInvisible="@{false}" />

      <TextView
        android:id="@+id/bluetooth_status"
        style="@style/Text.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:fontFamily="sans-serif-medium"
        android:text="[Searching...]"
        android:textColor="@color/darkGrey03"
        android:textSize="@dimen/text_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/floating_action_button"
        app:visibleOrInvisible="@{false}" />

      <TextView
        android:id="@+id/button_add"
        style="@style/Text.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:fontFamily="sans-serif-medium"
        android:onClick="@{() -> controller.onAddTransmitterClicked()}"
        android:text="[Add transmitter]"
        android:textColor="@color/colorAccent"
        android:textSize="@dimen/text_18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:visibleOrInvisible="@{controller.canAddMoreControllers}" />

    </androidx.constraintlayout.widget.ConstraintLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
