<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

  <data>

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.guides.GuideMenuController" />
  </data>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/toolbar_height"
    android:layout_marginStart="@dimen/spacing_larger"
    android:layout_marginEnd="@dimen/spacing_larger"
    android:orientation="vertical">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      style="@style/TextStyle.Coloplast.Bold.DarkGrey.32"
      android:text="@string/guides_menu_title" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/spacing_standard"
      android:layout_marginBottom="@dimen/spacing_triple"
      style="@style/TextStyle.Roboto.Regular.ClearGrey.18"
      android:text="@string/guides_menu_description" />



  </LinearLayout>
</layout>
