<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>

    <import type="android.view.View" />

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.dialogs.ImageDialogController" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent_black"
    android:onClick="@{() -> controller.onDismissClicked()}">

    <androidx.cardview.widget.CardView
      android:id="@+id/cardView"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="40dp"
      android:layout_marginEnd="40dp"
      app:cardBackgroundColor="@color/cardview_background"
      app:cardCornerRadius="@dimen/cardview_corner_radius"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="220dp"
          android:layout_marginStart="-2dp"
          android:background="@color/default_background">

          <ImageView
            android:layout_width="54dp"
            android:layout_height="86dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:tint="@color/icon_disabled"
            app:visibleOrGone="@{controller.showTopImage}"
            app:resource="@{controller.topImage}"
            tools:src="@drawable/ic_bluetooth" />

        </FrameLayout>

        <TextView
          android:id="@+id/title"
          style="@style/TextStyle.Coloplast.Bold.DarkGrey"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/spacing_standard"
          android:layout_marginTop="@dimen/spacing_double"
          android:layout_marginEnd="@dimen/spacing_standard"
          android:text="@{controller.titleResId}"
          android:textSize="@dimen/text_24"
          tools:text="@string/generic_error" />

        <TextView
          style="@style/Text.Large"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/spacing_standard"
          android:layout_marginTop="@dimen/spacing_half"
          android:layout_marginEnd="@dimen/spacing_standard"
          android:lineSpacingExtra="0dp"
          android:text="@{controller.messageResId}"
          android:textColor="@color/grey"
          tools:text="@string/generic_error_message" />

        <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginTop="@dimen/spacing_double"
          android:background="@color/divider" />

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="128dp"
          android:orientation="vertical"
          app:visibleOrGone="@{controller.verticalButtons}"
          tools:visibility="visible">

          <TextView
            style="@style/Text.Link"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center"
            android:onClick="@{() -> controller.onPositiveButtonClicked() }"
            android:text="@{controller.positiveButtonTextResId}"
            tools:text="@string/generic_quit" />

          <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

          <TextView
            style="@style/Text.Link"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@null"
            android:gravity="center"
            android:onClick="@{() -> controller.onNegativeButtonClicked() }"
            app:visibleOrGone="@{controller.showNegativeButton}"
            app:safeText="@{controller.negativeButtonTextResId}"
            tools:text="@string/generic_cancel" />

        </LinearLayout>

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="64dp"
          android:orientation="horizontal"
          android:padding="@dimen/spacing_standard"
          app:visibleOrGone="@{!controller.verticalButtons}"
          tools:visibility="gone">

          <TextView
            android:id="@+id/next_button"
            style="@style/Text.Link"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/spacing_standard"
            android:layout_weight="1"
            android:gravity="center"
            android:onClick="@{() -> controller.onNegativeButtonClicked() }"
            app:visibleOrGone="@{controller.showNegativeButton}"
            app:safeText="@{controller.negativeButtonTextResId}"
            tools:text="@string/generic_cancel"
            tools:visibility="visible" />

          <TextView
            style="@style/Text.Link"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:onClick="@{() -> controller.onPositiveButtonClicked() }"
            android:text="@{controller.positiveButtonTextResId}"
            tools:text="@string/generic_quit" />

        </LinearLayout>
      </LinearLayout>
    </androidx.cardview.widget.CardView>

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>