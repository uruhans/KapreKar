<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <import type="android.view.View" />

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.common.BaseFlowController" />

    <variable
      name="toolbarSupport"
      type="com.coloplast.olympus.ui.common.ToolbarSupportController" />

  </data>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_background"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
      style="@style/Toolbar"
      app:visibleOrGone="@{controller.showToolbar}"
      app:contentInsetEnd="0dp"
      app:contentInsetStart="0dp">

      <include
        android:id="@+id/toolbar"
        layout="@layout/view_toolbar"
        app:support="@{toolbarSupport}" />

    </androidx.appcompat.widget.Toolbar>

    <com.bluelinelabs.conductor.ChangeHandlerFrameLayout
      android:id="@+id/flow_controller_container"
      android:layout_width="match_parent"
      android:layout_height="match_parent" />

  </LinearLayout>
</layout>
