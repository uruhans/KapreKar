  <style name="TimePlaceHolder">
    <item name="android:height">76dp</item>
    <item name="android:background">@drawable/edittext_code_background</item>
    <item name="android:fontFamily">@font/coloplast_bold</item>
    <item name="android:textColor">@color/text_dark_grey</item>
    <item name="android:textSize">32sp</item>
    <item name="android:gravity">center</item>
  </style>

  <style name="GuideHeader" parent="TextStyle.Coloplast.Bold.DarkGrey">
    <item name="android:lineSpacingExtra">6dp</item>
    <item name="android:gravity">center</item>
  </style>

  <style name="GuideHeader.32" parent="GuideHeader">
    <item name="android:textSize">@dimen/text_32</item>
  </style>

  <style name="GuideHeader.20" parent="GuideHeader">
    <item name="android:textSize">@dimen/text_20</item>
  </style>

  <style name="GuideHeaderDescription" parent="TextStyle.Coloplast.Regular.ClearGrey">
    <item name="android:textSize">@dimen/text_30</item>
    <item name="android:gravity">center</item>
  </style>

  <style name="GuideHeaderDescription.18" parent="GuideHeaderDescription">
    <item name="android:textSize">@dimen/text_18</item>
  </style>

  <style name="GuideSubTitle" parent="TextStyle.Roboto.Regular.ClearGrey">
    <item name="android:textSize">@dimen/text_18</item>
    <item name="android:gravity">center</item>
  </style>

  <style name="Headline" parent="TextStyle.Coloplast.Bold.Grey" />

  <style name="Headline.XLarge" parent="Headline">
    <item name="android:textSize">@dimen/text_38</item>
    <item name="android:lineSpacingExtra">6dp</item>
  </style>

  <style name="Headline.Large" parent="Headline">
    <item name="android:textSize">@dimen/text_32</item>
