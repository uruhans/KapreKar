<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.onboarding.setup.SetupGuideSG5" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:paddingTop="@dimen/toolbar_height">

    <TextView
      android:id="@+id/setup_guide_sg4_title"
      style="@style/Headline.Small"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:text="@string/onboarding_chapter_applying_checklist_title"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

    <TextView
      android:id="@+id/setup_guide_sg4_description"
      style="@style/Text.Large"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginTop="@dimen/spacing_larger"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:text="@string/onboarding_chapter_applying_checklist_description"
      android:textColor="@color/darkGrey03"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/setup_guide_sg4_title" />

    <androidx.recyclerview.widget.RecyclerView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="@dimen/spacing_larger"
      android:layout_marginBottom="@dimen/spacing_standard"
      app:itemBinding="@{controller.itemBinding}"
      app:items="@{controller.items}"
      app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
      app:layout_constraintBottom_toTopOf="@+id/accept_button"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/setup_guide_sg4_description" />

    <Button
      android:id="@+id/accept_button"
      style="@style/Button"
      android:onClick="@{() -> controller.onNextClicked()}"
      android:text="@string/generic_continue"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent" />

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>