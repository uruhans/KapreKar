<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <variable
      name="toolbarSupport"
      type="com.coloplast.olympus.ui.common.ToolbarSupportController" />

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.guides.articles.GuideController" />
  </data>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
      android:id="@+id/toolbar"
      layout="@layout/view_toolbar"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:support="@{toolbarSupport}" />

    <androidx.recyclerview.widget.RecyclerView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/white"
      app:itemBinding="@{controller.itemBinding}"
      app:items="@{controller.items}"
      app:nestedScrollingEnabled="@{true}"
      app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

  </LinearLayout>

</layout>