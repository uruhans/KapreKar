<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

  <data>

    <variable
        name="controller"
        type="com.coloplast.olympus.ui.feature.transmitters.add.at9.AddTransmitterAT9Controller" />
  </data>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/white"
      android:gravity="center"
      android:orientation="vertical">

    <include
        layout="@layout/state_at9_searching"
        app:visibleOrGone="@{controller.CurrentState == 0}"
        tools:visibility="gone" />

    <include
        layout="@layout/state_at9_transmitters_found"
        app:controller="@{controller}"
        app:visibleOrGone="@{controller.CurrentState == 1}" />

  </LinearLayout>

</layout>
