<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>
    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.onboarding.signup.dataconsent.dc6.AcceptDataPromptDC6Controller" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
      android:id="@+id/linearLayout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:orientation="vertical"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent">

      <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginTop="@dimen/spacing_standard"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:src="@drawable/ic_faq"/>

      <TextView
        style="@style/TextStyle.Coloplast.Bold.DarkGrey.24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginTop="@dimen/spacing_standard"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:text="@string/onboarding_dc6_title"
        tools:text="@string/guide_at3_title" />

      <TextView
        android:id="@+id/title"
        style="@style/TextStyle.Roboto.Regular.ClearGrey.18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginTop="@dimen/spacing_standard"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:text="@string/onboarding_dc6_description"
        tools:text="@string/guide_at3_body" />

    </LinearLayout>

    <Button
      android:layout_height="wrap_content"
      android:layout_width="match_parent"
      style="@style/Button"
      android:text="@string/onboarding_dc6_button_1"
      android:onClick="@{()-> controller.onGoBack()}"
      app:layout_constraintBottom_toTopOf="@id/secondary_button" />

    <Button
      android:id="@+id/secondary_button"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      style="@style/Button.Secondary"
      android:textAllCaps="false"
      android:layout_marginStart="@dimen/spacing_larger"
      android:layout_marginEnd="@dimen/spacing_larger"
      android:layout_marginBottom="@dimen/spacing_larger"
      android:textSize="@dimen/text_18"
      android:text="@string/onboarding_dc6_button_1"
      android:onClick="@{()-> controller.onContinue()}"
      app:layout_constraintBottom_toBottomOf="parent" />

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>