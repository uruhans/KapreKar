<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.guides.GuideMenuController" />
  </data>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/toolbar_height"
    android:layout_marginStart="@dimen/spacing_larger"
    android:layout_marginBottom="@dimen/spacing_larger"
    android:orientation="vertical">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginEnd="@dimen/spacing_larger"
      style="@style/TextStyle.Coloplast.Bold.DarkGrey.32"
      android:text="@string/guides_menu_title" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/spacing_standard"
      android:layout_marginBottom="@dimen/spacing_triple"
      android:layout_marginEnd="@dimen/spacing_larger"
      style="@style/TextStyle.Roboto.Regular.ClearGrey.18"
      android:text="@string/guides_menu_description" />

    <androidx.recyclerview.widget.RecyclerView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:clipToPadding="false"
      android:orientation="vertical"
      app:itemBinding="@{controller.itemBinding}"
      app:items="@{controller.items}"
      app:defaultDecorator="@{true}"
      app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
  </LinearLayout>
</layout>
