<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.transmitters.add.at10.AddTransmitterAT10Controller" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/top"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_margin="@dimen/spacing_larger"
      android:gravity="center"
      android:orientation="vertical"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintTop_toTopOf="parent">

      <FrameLayout
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:background="@drawable/shape_turquoise_circle"
        android:gravity="center">

        <ImageView
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_margin="@dimen/spacing_large"
          android:src="@drawable/ic_checkmark" />

      </FrameLayout>

      <TextView
        android:id="@+id/transmitter_guide_at1_title"
        style="@style/GuideHeader.32"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_double"
        android:layout_marginBottom="@dimen/spacing_standard"
        android:text="@string/guide_at10_title" />

      <TextView
        android:id="@+id/application_guide_description"
        style="@style/GuideHeaderDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/guide_at10_body" />

    </LinearLayout>

    <Button
      style="@style/Button"
      android:onClick="@{() -> controller.onCloseButtonClicked()}"
      android:text="@string/generic_continue"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent" />

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>