<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.transmitters.add.at9.AddTransmitterAT9Controller" />
  </data>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
      style="@style/TextStyle.Coloplast.Bold.DarkGrey.24"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="100dp"
      android:text="@string/overlay_multiple_transmitters_found_title" />

    <TextView
      style="@style/TextStyle.Roboto.Regular.ClearGrey.18"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/spacing_standard"
      android:text="@string/overlay_multiple_transmitters_found_body" />

    <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/recyclerView"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="@dimen/spacing_standard"
      android:layout_weight="1"
      app:itemBinding="@{controller.itemBinding}"
      app:items="@{controller.items}"
      app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <Button
      style="@style/Button.Selectable"
      android:enabled="@{controller.selectedScanResult != null}"
      android:onClick="@{() -> controller.onSelectionConfirmed()}"
      android:text="@string/overlay_multiple_transmitters_found_action" />

  </LinearLayout>
</layout>