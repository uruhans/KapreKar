<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>
    <variable
      name="view"
      type="com.coloplast.olympus.ui.common.widgets.EmailView" />
  </data>

  <merge
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <com.google.android.material.textfield.TextInputLayout
      android:id="@+id/email_input_layout"
      style="@style/TextInputLayoutAppearance"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginTop="@dimen/spacing_small"
      android:layout_marginEnd="@dimen/spacing_standard"
      app:errorEnabled="false">

      <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/email_edit_text"
        style="@style/EditTextInputText"
        android:background="@drawable/edittext_background"
        android:hint="@string/onboarding_email_hint"
        android:inputType="textEmailAddress"
        android:text="@={view.email}"
        app:backgroundResource="@{view.emailBackgroundDrawableResId}"
        app:onFocusChangeListener="@{view.focusListener}"
        app:onSubmit="@{() -> view.onKeyboardActionDoneClicked()}" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
      style="@style/TextInputLayoutErrorText"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginTop="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:text="@string/onboarding_email_error"
      app:visibleOrGone="@{view.showInvalidEmailText}" />

  </merge>
</layout>