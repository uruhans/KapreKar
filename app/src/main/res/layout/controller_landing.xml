<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.onboarding.LandingController" />
  </data>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="bottom|center"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_standard"
    android:paddingEnd="@dimen/spacing_standard"
    app:visibleOrInvisible="@{controller.isVisible}">


    <ImageView
      android:id="@+id/landing_logo"
      android:layout_width="104dp"
      android:layout_height="104dp"
      android:layout_marginBottom="@dimen/spacing_triple"
      android:background="@drawable/shape_turquoise_circle"
      android:padding="@dimen/spacing_larger"
      android:src="@drawable/ic_profile" />

    <TextView
      android:id="@+id/title"
      style="@style/TextStyle.Coloplast.Bold.DarkGrey.32"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/spacing_double"
      android:paddingStart="@dimen/spacing_triple"
      android:paddingEnd="@dimen/spacing_triple"
      android:text="@string/onboarding_landing_title"
      android:textAlignment="center"/>

    <TextView
      android:id="@+id/description"
      style="@style/TextStyle.Roboto.Regular.ClearGrey.18"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/spacing_standard"
      android:layout_marginBottom="@dimen/spacing_quadruple"
      android:paddingStart="@dimen/spacing_double"
      android:paddingEnd="@dimen/spacing_double"
      android:text="@string/onboarding_landing_subtitle"
      android:textAlignment="center" />

    <Button
      android:id="@+id/create_profile_button"
      style="@style/Button"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/spacing_small"
      android:onClick="@{() -> controller.onCreateProfileClicked()}"
      android:text="@string/onboarding_landing_create_profile_button" />

    <Button
      android:id="@+id/log_in_button"
      style="@style/Button.Secondary"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:onClick="@{() -> controller.onLogInClicked()}"
      android:text="@string/onboarding_landing_log_in_button" />

  </LinearLayout>
</layout>