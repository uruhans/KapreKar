<?xml version="1.0" encoding="utf-8"?>
<layout>

  <data>

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.home.HomeController" />
  </data>

  <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="bottom"
    android:orientation="vertical">

    <TextView
      style="@style/Headline.Large"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:text="Bluetooth\nis disabled" />

    <TextView
      style="@style/Headline.Large"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/spacing_half"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:fontFamily="@font/coloplast"
      android:text="Turn on bluetooth to begin monitoring."
      android:textColor="@color/grey" />

    <androidx.cardview.widget.CardView
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:layout_marginTop="@dimen/spacing_double"
      android:layout_marginBottom="@dimen/spacing_double"
      android:foreground="?attr/selectableItemBackground"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      app:cardPreventCornerOverlap="true"
      android:onClick="@{() -> controller.enableBluetoothClicked()}"
      app:cardUseCompatPadding="false"
      app:cardBackgroundColor="@color/white"
      app:cardCornerRadius="28dp"
      app:cardElevation="4dp">

      <TextView
        style="@style/Text.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="Enable bluetooth"
        android:textSize="18sp" />

    </androidx.cardview.widget.CardView>


  </LinearLayout>
</layout>