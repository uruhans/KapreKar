<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>

    <variable
      name="item"
      type="com.coloplast.olympus.ui.feature.transmitters.add.models.ChecklistItem" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_large">

    <ImageView
      android:id="@+id/imageView"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginTop="@dimen/spacing_standard"
      android:src="@drawable/ic_checkmark"
      android:tint="@color/text_blue_green"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

    <TextView
      android:id="@+id/textView"
      style="@style/Text.Large"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginTop="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:lineSpacingExtra="0dp"
      android:textAppearance="@style/Headline.XSmall"
      android:textColor="@color/darkGrey01"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@+id/imageView"
      app:layout_constraintTop_toTopOf="parent"
      app:safeText="@{item.title}"
      tools:text="The transmitter you would like to add" />

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>