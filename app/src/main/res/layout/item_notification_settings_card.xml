<?xml version="1.0" encoding="utf-8"?>
<layout>

  <data>
    <variable
      name="buttonClickListener"
      type="android.view.View.OnClickListener" />
  </data>

  <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cardview_not_selected"
    app:cardCornerRadius="@dimen/cardview_corner_radius"
    app:cardElevation="@dimen/cardview_elevation_default"
    app:cardUseCompatPadding="true">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_larger"
      android:layout_marginTop="@dimen/spacing_larger"
      android:layout_marginEnd="@dimen/spacing_larger"
      android:layout_marginBottom="@dimen/spacing_small"
      android:orientation="vertical">

      <TextView
        style="@style/TextStyle.Coloplast.Bold.DarkGrey.24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_notifications_show_preview_header" />

      <TextView
        style="@style/TextStyle.Roboto.Regular.ClearGrey.16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_small"
        android:text="@string/settings_notifications_show_preview_body" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/spacing_small"
        android:paddingBottom="@dimen/spacing_small"
        android:text="@string/settings_notifications_link"
        style="@style/TextStyle.Roboto.Medium.Turquoise.18"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:onClick="@{buttonClickListener}"/>

    </LinearLayout>

  </androidx.cardview.widget.CardView>

</layout>


