<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>

    <variable
      name="item"
      type="com.coloplast.olympus.ui.feature.home.models.ScanResultItem" />
  </data>

  <androidx.cardview.widget.CardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_standard"
    android:foreground="?android:attr/selectableItemBackground"
    android:onClick="@{() -> item.onItemClicked()}"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:background="@{item.selected ? @drawable/cardview_selected_with_outline : @drawable/cardview_not_selected}"
      android:layout_height="84dp">

      <TextView
        android:id="@+id/name"
        style="@style/TextStyle.Coloplast.Bold.DarkGrey.20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_larger"
        android:layout_marginTop="@dimen/spacing_standard"
        android:text="@{item.ScanResult.name}"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="[Name]" />

      <TextView
        android:id="@+id/address"
        style="@style/TextStyle.Roboto.Regular.ClearGrey.18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_larger"
        android:text="@{item.scanResult.macAddress}"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/name"
        tools:text="[Address]" />

    </androidx.constraintlayout.widget.ConstraintLayout>

  </androidx.cardview.widget.CardView>
</layout>