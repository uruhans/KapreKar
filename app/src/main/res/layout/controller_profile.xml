<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>

    <import type="com.coloplast.olympus.R" />

    <variable
      name="toolbarSupport"
      type="com.coloplast.olympus.ui.common.ToolbarSupportController" />

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.profile.ProfileController" />
  </data>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include
      android:id="@+id/toolbar"
      layout="@layout/view_toolbar"
      app:support="@{toolbarSupport}" />

    <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      app:visibleOrGone="@{controller.hasUserProfile}"
      tools:visibility="gone">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_larger"
        android:layout_marginEnd="@dimen/spacing_larger"
        android:layout_marginBottom="@dimen/spacing_double"
        android:orientation="vertical">

        <TextView
          style="@style/TextStyle.Coloplast.Bold.DarkGrey.32"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/profile_pp_title" />

        <TextView
          style="@style/TextStyle.Coloplast.Bold.DarkGrey.20"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/spacing_double"
          android:text="@string/profile_pp_header_1" />

        <TextView
          style="@style/TextStyle.Roboto.Regular.ClearGrey.14"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/spacing_standard"
          android:text="@string/profile_pp_first_name" />

        <EditText
          style="@style/TextStyle.Roboto.Regular.Grey"
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:layout_marginTop="@dimen/spacing_quarter"
          android:background="@drawable/edittext_background"
          android:enabled="@{controller.editingEnabled}"
          android:focusable="false"
          android:focusableInTouchMode="false"
          android:focusedByDefault="false"
          android:gravity="center_vertical"
          android:paddingStart="@dimen/spacing_standard"
          android:paddingEnd="@dimen/spacing_standard"
          app:safeText="@{controller.firstName}" />

        <TextView
          style="@style/TextStyle.Roboto.Regular.ClearGrey.14"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/spacing_standard"
          android:text="@string/profile_pp_last_name" />

        <EditText
          style="@style/TextStyle.Roboto.Regular.Grey"
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:layout_marginTop="@dimen/spacing_quarter"
          android:background="@drawable/edittext_background"
          android:enabled="@{controller.editingEnabled}"
          android:focusable="false"
          android:focusableInTouchMode="false"
          android:focusedByDefault="false"
          android:gravity="center_vertical"
          android:paddingStart="@dimen/spacing_standard"
          android:paddingEnd="@dimen/spacing_standard"
          app:safeText="@{controller.lastName}" />

        <TextView
          style="@style/TextStyle.Roboto.Regular.ClearGrey.14"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/spacing_standard"
          android:text="@string/profile_pp_telephone" />

        <EditText
          style="@style/TextStyle.Roboto.Regular.Grey"
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:layout_marginTop="@dimen/spacing_quarter"
          android:background="@drawable/edittext_background"
          android:enabled="@{controller.editingEnabled}"
          android:focusable="false"
          android:focusableInTouchMode="false"
          android:focusedByDefault="false"
          android:gravity="center_vertical"
          android:paddingStart="@dimen/spacing_standard"
          android:paddingEnd="@dimen/spacing_standard"
          app:safeText="@{controller.phoneNumber}" />

        <TextView
          style="@style/TextStyle.Roboto.Regular.ClearGrey.14"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/spacing_standard"
          android:text="@string/profile_pp_email" />

        <EditText
          style="@style/TextStyle.Roboto.Regular.Grey"
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:layout_marginTop="@dimen/spacing_quarter"
          android:background="@drawable/edittext_background"
          android:enabled="@{controller.editingEnabled}"
          android:focusable="false"
          android:focusableInTouchMode="false"
          android:focusedByDefault="false"
          android:gravity="center_vertical"
          android:paddingStart="@dimen/spacing_standard"
          android:paddingEnd="@dimen/spacing_standard"
          app:safeText="@{controller.email}" />

        <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginTop="@dimen/spacing_double"
          android:background="@color/ten_percent_transparent_black" />

        <TextView
          style="@style/TextStyle.Coloplast.Bold.DarkGrey.20"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/spacing_double"
          android:text="@string/profile_pp_header_2" />

        <TextView
          style="@style/TextStyle.Roboto.Regular.ClearGrey.14"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/spacing_standard"
          android:text="@string/profile_pp_stoma_type" />

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@drawable/edittext_background"
          android:orientation="horizontal">

          <com.coloplast.olympus.ui.common.widgets.NoDefaultSpinner
            android:layout_width="0dp"
            android:layout_height="@dimen/cardview_button_height_default"
            android:layout_weight="1"
            android:clickable="@{controller.editingEnabled}"
            android:enabled="@{controller.editingEnabled}"
            android:entries="@{controller.stomaValues}"
            android:prompt="@string/onboarding_insurance_hint"
            android:selectedItemPosition="@={controller.stomaSpinnerPosition}"
            android:spinnerMode="dialog" />

          <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/spacing_standard"
            android:src="@drawable/ic_baseline_keyboard_arrow_down_24"
            app:tintDrawable="@{R.color.chevron_dropdown}" />

        </LinearLayout>

        <TextView
          style="@style/TextStyle.Roboto.Regular.ClearGrey.14"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/spacing_standard"
          android:text="@string/profile_pp_stoma_surgery_date" />

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@drawable/edittext_background"
          android:orientation="horizontal">

          <com.coloplast.olympus.ui.common.widgets.NoDefaultSpinner
            android:layout_width="0dp"
            android:layout_height="@dimen/cardview_button_height_default"
            android:layout_weight="1"
            android:clickable="@{controller.editingEnabled}"
            android:enabled="@{controller.editingEnabled}"
            android:entries="@{controller.surgeryDateValues}"
            android:prompt="@string/onboarding_insurance_hint"
            android:selectedItemPosition="@={controller.surgerySpinnerPosition}"
            android:spinnerMode="dialog" />

          <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/spacing_standard"
            android:src="@drawable/ic_baseline_keyboard_arrow_down_24"
            app:tintDrawable="@{R.color.chevron_dropdown}" />

        </LinearLayout>

        <TextView
          style="@style/TextStyle.Roboto.Regular.ClearGrey.14"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/spacing_standard"
          android:text="@string/profile_pp_health_insurance"
          app:visibleOrGone="@{controller.showHealthInsurance}" />

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@drawable/edittext_background"
          android:orientation="horizontal">

          <com.coloplast.olympus.ui.common.widgets.NoDefaultSpinner
            android:layout_width="0dp"
            android:layout_height="@dimen/cardview_button_height_default"
            android:layout_weight="1"
            android:clickable="@{controller.editingEnabled}"
            android:enabled="@{controller.editingEnabled}"
            android:entries="@{controller.insuranceValues}"
            android:prompt="@string/onboarding_insurance_hint"
            android:selectedItemPosition="@={controller.insuranceSpinnerPosition}"
            android:spinnerMode="dialog" />

          <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/spacing_standard"
            android:src="@drawable/ic_baseline_keyboard_arrow_down_24"
            app:tintDrawable="@{R.color.chevron_dropdown}" />

        </LinearLayout>

        <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginTop="@dimen/spacing_double"
          android:background="@color/ten_percent_transparent_black" />

        <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginTop="@dimen/spacing_double"
          android:layout_marginBottom="@dimen/spacing_standard">

          <TextView
            android:id="@+id/data_policy_card_title"
            style="@style/TextStyle.Coloplast.Bold.DarkGrey.20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_dc5_card_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

          <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/data_policy_card_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="@={controller.dataPolicyAccepted}"
            app:layout_constraintBottom_toBottomOf="@id/data_policy_card_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

          <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="start"
            app:constraint_referenced_ids="data_policy_card_switch" />

          <TextView
            android:id="@+id/data_policy_card_description"
            style="@style/TextStyle.Roboto.Regular.ClearGrey.16"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/onboarding_dc5_card_description"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/barrier"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/data_policy_card_switch" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <Button
          android:id="@+id/policy_agreement_button"
          style="@style/Button.Borderless"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="@dimen/spacing_half"
          android:onClick="@{() -> controller.onPolicyAgreementClicked()}"
          android:text="@string/onboarding_dc5_link1_text"
          android:textAlignment="textStart"
          android:textAllCaps="false"
          android:textSize="@dimen/text_18" />

        <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginTop="@dimen/spacing_standard"
          android:background="@color/ten_percent_transparent_black" />

        <Button
          style="@style/Button.Secondary"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/spacing_none"
          android:layout_marginTop="@dimen/spacing_double"
          android:layout_marginEnd="@dimen/spacing_none"
          android:onClick="@{() -> controller.onLogoutClicked()}"
          android:text="@string/profile_pp_log_out_button" />

      </LinearLayout>

    </ScrollView>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_larger"
      android:layout_marginEnd="@dimen/spacing_larger"
      android:layout_marginBottom="@dimen/spacing_double"
      app:visibleOrGone="@{!controller.hasUserProfile}"
      android:orientation="vertical">

      <TextView
        style="@style/TextStyle.Coloplast.Bold.DarkGrey.32"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_pp_title" />

      <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="@dimen/spacing_triple"
        android:src="@drawable/ic_info_circle"
        app:tint="@color/colorAccent" />

      <TextView
        style="@style/TextStyle.Coloplast.Bold.DarkGrey.24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_standard"
        android:text="@string/profile_pp_no_profile_title" />

      <TextView
        style="@style/TextStyle.Roboto.Regular.ClearGrey.18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_small"
        android:text="@string/profile_pp_no_profile_description" />

    </LinearLayout>

  </LinearLayout>
</layout>
