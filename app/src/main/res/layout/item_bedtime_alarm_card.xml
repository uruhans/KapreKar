<?xml version="1.0" encoding="utf-8"?>
<layout>

  <data>

    <variable
      name="buttonClickListener"
      type="android.view.View.OnClickListener" />

    <variable
      name="bedTimeAlertsEnabled"
      type="Boolean" />

    <variable
      name="bedTimePeriode"
      type="String" />

  </data>

  <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cardview_not_selected"
    app:cardCornerRadius="@dimen/cardview_corner_radius"
    app:cardElevation="@dimen/cardview_elevation_default"
    app:cardUseCompatPadding="true">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_larger"
      android:layout_marginTop="@dimen/spacing_larger"
      android:layout_marginBottom="@dimen/spacing_small"
      android:layout_marginEnd="@dimen/spacing_larger"
      android:orientation="vertical">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
          style="@style/TextStyle.Coloplast.Bold.DarkGrey.24"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:drawableStart="@drawable/ic_clock"
          android:drawablePadding="@dimen/spacing_half"
          android:gravity="center_vertical"
          android:text="@string/settings_bedtime_alerts_header" />

        <Switch
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_weight="0"
          android:visibility="visible"
          android:checked="@={bedTimeAlertsEnabled}"
          />

      </LinearLayout>

      <TextView
        style="@style/TextStyle.Roboto.Regular.ClearGrey.16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_small"
        android:text="@string/settings_bedtime_alerts_body" />

      <TextView
        style="@style/TextStyle.Roboto.Regular.DarkGrey.18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/spacing_small"
        android:gravity="center_vertical"
        android:text="@string/settings_bedtime_alerts_schedule_title"
        app:visibleOrGoneFade="@{bedTimeAlertsEnabled}"/>

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/spacing_quarter"
        android:paddingBottom="@dimen/spacing_small"
        android:focusable="true"
        android:onClick="@{buttonClickListener}"
        app:visibleOrGoneFade="@{bedTimeAlertsEnabled}">
        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@{bedTimePeriode}"
          android:gravity="center_vertical"
          style="@style/TextStyle.Roboto.Medium.Turquoise.18"
          android:background="?attr/selectableItemBackground"/>
        <ImageView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_weight="0"
          android:gravity="center_vertical"
          android:src="@drawable/ic_chevron_right"
          />
      </LinearLayout>

    </LinearLayout>

  </androidx.cardview.widget.CardView>

</layout>


