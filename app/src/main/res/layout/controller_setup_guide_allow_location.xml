<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <import type="com.coloplast.olympus.R" />

    <variable
      name="toolbarSupport"
      type="com.coloplast.olympus.ui.common.ToolbarSupportController" />

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.onboarding.setup.connection.SetupGuideLocationSGC4Controller" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <include
      android:id="@+id/toolbar"
      layout="@layout/view_toolbar"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:support="@{toolbarSupport}" />

    <androidx.constraintlayout.widget.Guideline
      android:id="@+id/guideline"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:orientation="horizontal"
      app:layout_constraintGuide_percent=".5" />

    <com.coloplast.olympus.ui.common.widgets.MediaView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:contentDescription="@string/onboarding_chapter_connecting_allow_location_title"
      app:layout_constraintBottom_toTopOf="@+id/guideline"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:resource="@{R.raw.sg_c4_alwaysallow_android}"
      app:isLooping="@{true}" />

    <LinearLayout
      android:id="@+id/linearLayout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:orientation="vertical"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="@+id/guideline">

      <TextView
        style="@style/Text.Medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginTop="@dimen/spacing_standard"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:text="@string/onboarding_chapter_connecting_allow_location_title"
        android:textColor="@color/darkGrey03" />

      <TextView
        android:id="@+id/title"
        style="@style/Headline.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginTop="@dimen/spacing_standard"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:text="@string/onboarding_chapter_connecting_allow_location_description" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/fab_help"
      android:layout_width="56dp"
      android:layout_height="56dp"
      android:layout_marginEnd="@dimen/spacing_double"
      android:contentDescription="@string/guide_faq_question_1"
      android:onClick="@{() -> controller.onQuestionClicked()}"
      android:src="@drawable/ic_icon_questionmark"
      app:backgroundTint="@color/white"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:visibleOrGone="@{controller.showQuestionFab}" />

    <com.coloplast.olympus.ui.common.widgets.CustomTabLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_double"
      app:currentIndex="@{controller.position}"
      app:layout_constraintBottom_toBottomOf="@id/next_button"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="@id/next_button"
      app:totalCount="@{controller.totalCount}" />

    <Button
      android:id="@+id/next_button"
      style="@style/Button"
      android:onClick="@{() -> controller.onNextClicked()}"
      android:text="@{controller.buttonText}"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent" />

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>