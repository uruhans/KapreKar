<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <variable
      name="drawableId"
      type="Integer" />

    <variable
      name="titleId"
      type="Integer" />

    <variable
      name="descriptionId"
      type="Integer" />
  </data>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:safeResource="@{drawableId}" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_larger"
      android:layout_marginEnd="@dimen/spacing_larger"
      android:layout_marginTop="@dimen/spacing_double"
      android:layout_marginBottom="@dimen/spacing_standard"
      app:safeText="@{titleId}"
      style="@style/TextStyle.Coloplast.Bold.DarkGrey.24" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_larger"
      android:layout_marginEnd="@dimen/spacing_larger"
      app:safeText="@{descriptionId}"
      style="@style/TextStyle.Roboto.Regular.ClearGrey.18" />
  </LinearLayout>
</layout>
