<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:android="http://schemas.android.com/apk/res/android">
  <data>
    <import type="com.coloplast.olympus.R" />
    <import type="com.coloplast.olympus.ui.feature.onboarding.setup.model.SensorLayerSizeType" />

    <variable
      name="toolbarSupport"
      type="com.coloplast.olympus.ui.common.ToolbarSupportController" />

    <import type="com.coloplast.olympus.ui.feature.onboarding.setup.SetupGuideSG4SensorLayerSize" />
    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.onboarding.setup.SetupGuideSG4SensorLayerSize" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_background">

    <include
      android:id="@+id/toolbar"
      layout="@layout/view_toolbar"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:support="@{toolbarSupport}" />

    <TextView
      android:id="@+id/title"
      style="@style/TextStyle.Coloplast.Bold.DarkGrey.24"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_margin="@dimen/spacing_larger"
      android:text="@string/onboarding_chapter_preparing_sl_size_select_title"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <TextView
      android:id="@+id/description"
      style="@style/TextStyle.Roboto.Regular.ClearGrey.18"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_larger"
      android:layout_marginTop="@dimen/spacing_half"
      android:layout_marginEnd="@dimen/spacing_larger"
      android:layout_marginBottom="@dimen/spacing_larger"
      android:text="@string/onboarding_chapter_preparing_sl_size_select_description"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/title" />

    <androidx.cardview.widget.CardView
      android:id="@+id/sensor_size_40"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_marginStart="@dimen/spacing_larger"
      android:layout_marginEnd="@dimen/spacing_half"
      android:layout_marginTop="@dimen/spacing_double"
      android:layout_weight="1"
      android:background="@{(controller.selectedSize == SensorLayerSizeType.SIZE_40.ordinal()) ? @drawable/cardview_selected_with_outline : @drawable/cardview_not_selected}"
      android:elevation="@dimen/cardview_elevation_default"
      android:onClick="@{() -> controller.onSensorLayerClicked(SensorLayerSizeType.SIZE_40)}"
      app:cardUseCompatPadding="true"
      app:layout_constraintBottom_toTopOf="@+id/sensor_size_60"
      app:layout_constraintEnd_toStartOf="@+id/sensor_size_50"
      app:layout_constraintHorizontal_bias="0.5"
      app:layout_constraintHorizontal_chainStyle="spread"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/description">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

        <TextView
          style="@style/TextStyle.Coloplast.Bold.DarkGrey.32"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingStart="@dimen/spacing_larger"
          android:paddingEnd="@dimen/spacing_larger"
          android:text="@integer/sensor_layer_size_40"
          android:textAlignment="center" />
      </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
      android:id="@+id/sensor_size_50"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_marginEnd="@dimen/spacing_larger"
      android:layout_weight="1"
      android:background="@{(controller.selectedSize == SensorLayerSizeType.SIZE_50.ordinal()) ? @drawable/cardview_selected_with_outline : @drawable/cardview_not_selected}"
      android:elevation="@dimen/cardview_elevation_default"
      android:onClick="@{() -> controller.onSensorLayerClicked(SensorLayerSizeType.SIZE_50)}"
      app:cardUseCompatPadding="true"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.5"
      app:layout_constraintHorizontal_chainStyle="spread"
      app:layout_constraintStart_toEndOf="@+id/sensor_size_40"
      app:layout_constraintBottom_toBottomOf="@+id/sensor_size_40"
      app:layout_constraintTop_toTopOf="@+id/sensor_size_40">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

        <TextView
          style="@style/TextStyle.Coloplast.Bold.DarkGrey.32"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingStart="@dimen/spacing_larger"
          android:paddingEnd="@dimen/spacing_larger"
          android:text="@integer/sensor_layer_size_50"
          android:textAlignment="center" />
      </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
      android:id="@+id/sensor_size_60"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_marginStart="@dimen/spacing_larger"
      android:layout_marginTop="@dimen/spacing_half"
      android:layout_marginEnd="@dimen/spacing_half"
      android:layout_weight="1"
      android:background="@{(controller.selectedSize == SensorLayerSizeType.SIZE_60.ordinal()) ? @drawable/cardview_selected_with_outline : @drawable/cardview_not_selected}"
      android:elevation="@dimen/cardview_elevation_default"
      android:onClick="@{() -> controller.onSensorLayerClicked(SensorLayerSizeType.SIZE_60)}"
      app:cardUseCompatPadding="true"
      app:layout_constraintBottom_toTopOf="@+id/sensor_size_80"
      app:layout_constraintEnd_toStartOf="@+id/sensor_size_70"
      app:layout_constraintHorizontal_bias="0.5"
      app:layout_constraintHorizontal_chainStyle="spread"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/sensor_size_40">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

        <TextView
          style="@style/TextStyle.Coloplast.Bold.DarkGrey.32"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingStart="@dimen/spacing_larger"
          android:paddingEnd="@dimen/spacing_larger"
          android:text="@integer/sensor_layer_size_60"
          android:textAlignment="center" />
      </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
      android:id="@+id/sensor_size_70"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_marginEnd="@dimen/spacing_larger"
      android:layout_weight="1"
      android:background="@{(controller.selectedSize == SensorLayerSizeType.SIZE_70.ordinal()) ? @drawable/cardview_selected_with_outline : @drawable/cardview_not_selected}"
      android:elevation="@dimen/cardview_elevation_default"
      android:onClick="@{() -> controller.onSensorLayerClicked(SensorLayerSizeType.SIZE_70)}"
      app:cardUseCompatPadding="true"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.5"
      app:layout_constraintHorizontal_chainStyle="spread"
      app:layout_constraintStart_toEndOf="@+id/sensor_size_60"
      app:layout_constraintBottom_toBottomOf="@+id/sensor_size_60"
      app:layout_constraintTop_toTopOf="@+id/sensor_size_60">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

        <TextView
          style="@style/TextStyle.Coloplast.Bold.DarkGrey.32"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingStart="@dimen/spacing_larger"
          android:paddingEnd="@dimen/spacing_larger"
          android:text="@integer/sensor_layer_size_70"
          android:textAlignment="center" />
      </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
      android:id="@+id/sensor_size_80"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_marginTop="@dimen/spacing_half"
      android:layout_marginBottom="@dimen/spacing_triple"
      android:layout_weight="1"
      android:background="@{(controller.selectedSize == SensorLayerSizeType.SIZE_80.ordinal()) ? @drawable/cardview_selected_with_outline : @drawable/cardview_not_selected}"
      android:elevation="@dimen/cardview_elevation_default"
      android:onClick="@{() -> controller.onSensorLayerClicked(SensorLayerSizeType.SIZE_80)}"
      app:cardUseCompatPadding="true"
      app:layout_constraintBottom_toTopOf="@+id/confirm_btn"
      app:layout_constraintStart_toStartOf="@+id/sensor_size_40"
      app:layout_constraintEnd_toEndOf="@+id/sensor_size_40"
      app:layout_constraintTop_toBottomOf="@+id/sensor_size_60">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

        <TextView
          style="@style/TextStyle.Coloplast.Bold.DarkGrey.32"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingStart="@dimen/spacing_larger"
          android:paddingEnd="@dimen/spacing_larger"
          android:text="@integer/sensor_layer_size_80"
          android:textAlignment="center" />
      </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
      android:id="@+id/confirm_btn"
      style="@style/Button"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_larger"
      android:layout_marginEnd="@dimen/spacing_larger"
      android:onClick="@{() -> controller.onNextClicked() }"
      android:text="@string/generic_confirm"
      app:visibleOrInvisibleFade="@{controller.selectedSize != 0}"
      app:layout_constraintBottom_toBottomOf="parent" />

  </androidx.constraintlayout.widget.ConstraintLayout>

</layout>