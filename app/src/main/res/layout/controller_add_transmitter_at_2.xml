<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.transmitters.add.at2.AddTransmitterAT2Controller" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <TextView
      android:id="@+id/transmitter_guide_at2_title"
      style="@style/Headline.Small"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:text="@string/guide_at2_title"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

    <TextView
      android:id="@+id/transmitter_guide_at2_description"
      style="@style/Text.Large"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginTop="@dimen/spacing_larger"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:text="@string/guide_at2_body"
      android:textColor="@color/darkGrey03"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/transmitter_guide_at2_title" />

    <androidx.recyclerview.widget.RecyclerView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="@dimen/spacing_larger"
      android:layout_marginBottom="@dimen/spacing_standard"
      app:itemBinding="@{controller.itemBinding}"
      app:items="@{controller.items}"
      app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
      app:layout_constraintBottom_toTopOf="@+id/accept_button"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/transmitter_guide_at2_description" />

    <Button
      android:id="@+id/accept_button"
      android:layout_width="match_parent"
      android:layout_height="@dimen/cardview_button_height_default"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:layout_marginBottom="@dimen/spacing_double"
      android:onClick="@{() -> controller.onNextClicked()}"
      android:background="@drawable/button_color_accent"
      android:text="@string/guide_at2_action"
      android:textAllCaps="false"
      android:textColor="@color/white"
      android:textSize="@dimen/text_18"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent" />

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>