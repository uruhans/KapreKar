<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>
    <import type="com.coloplast.olympus.R" />
    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.onboarding.dataconsent.dc5.AcceptTermsDC5Controller" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layout_marginTop="@dimen/toolbar_height">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:layout_marginEnd="@dimen/spacing_larger"
      android:layout_marginStart="@dimen/spacing_double"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent">

      <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_agree_terms" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_double"
        android:layout_marginBottom="@dimen/spacing_standard"
        android:text="@string/onboarding_dc5_title"
        style="@style/TextStyle.Coloplast.Bold.DarkGrey.24" />

      <Button
        android:id="@+id/policy_agreement_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        safeText="@{R.string.onboarding_dc5_link1_text}"
        style="@style/Button.Borderless"
        android:textAllCaps="false"
        android:textSize="@dimen/text_18"
        android:textAlignment="textStart"
        android:onClick="@{() -> controller.onPolicyAgreementClicked()}"/>

      <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/cardview_not_selected"
        app:cardCornerRadius="@dimen/cardview_corner_radius"
        app:cardElevation="@dimen/cardview_elevation_default"
        app:cardUseCompatPadding="true">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_margin="@dimen/spacing_standard"
          android:orientation="vertical">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
              style="@style/TextStyle.Coloplast.Bold.DarkGrey.24"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:gravity="center_vertical"
              android:drawablePadding="@dimen/spacing_half"
              android:text="@string/onboarding_dc5_card_title" />

            <Switch
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_weight="0"
              android:checked="@={controller.dataPolicyAccepted}" />

          </LinearLayout>

          <TextView
            style="@style/TextStyle.Roboto.Regular.ClearGrey.16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginBottom="@dimen/spacing_small"
            android:text="@string/onboarding_dc5_card_description" />

        </LinearLayout>



      </androidx.cardview.widget.CardView>


    </LinearLayout>

    <Button
      android:layout_height="wrap_content"
      android:layout_width="match_parent"
      style="@style/Button"
      app:safeText="@{R.string.generic_continue}"
      android:onClick="@{()-> controller.onContinueClicked()}"
      app:layout_constraintBottom_toBottomOf="parent" />

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>