<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <layer-list>
      <item>
        <shape >
          <gradient
            android:centerY="0.1"
            android:startColor="@color/edittext_drop_shadow"
            android:centerColor="#ffffff"
            android:endColor="#ffffff"
            android:angle="270" />
          <corners android:radius="8dp" />
          <stroke
            android:width="1dp"
            android:color="@color/edittext_border" />
        </shape>
      </item>
      <item android:drawable="@drawable/ic_chevron" android:gravity="center_vertical|right" android:right="@dimen/spacing_large"/>
    </layer-list>
  </item>
</selector>