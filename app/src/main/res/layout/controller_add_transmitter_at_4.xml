<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="toolbarSupport"
            type="com.coloplast.olympus.ui.common.ToolbarSupportController" />

        <variable
            name="controller"
            type="com.coloplast.olympus.ui.feature.transmitters.add.at4.AddTransmitterAT4Controller" />


    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:support="@{toolbarSupport}" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="@dimen/spacing_larger"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/transmitter_guide_at1_title"
                style="@style/GuideHeader.32"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_double"
                android:layout_marginBottom="@dimen/spacing_standard"
                android:text="@string/guide_at4_title" />

            <TextView
                android:id="@+id/application_guide_description"
                style="@style/GuideHeaderDescription.18"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_at4_body" />

            <com.coloplast.olympus.ui.common.widgets.InputCodeEditText
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_double"
                app:listener="@{controller}"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>