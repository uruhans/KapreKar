<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.update.TransmitterChargingController" />

  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:orientation="vertical"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_bias="1">

      <ImageView
        android:layout_width="54dp"
        android:layout_height="86dp"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_battery_charging"
        android:contentDescription="@string/guide_update_transmitter_1_title"
        tools:tint="@color/icon_disabled" /> <!-- TODO change to the plug icon -->

      <TextView
        style="@style/Headline.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginTop="@dimen/spacing_standard"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:text="@string/guide_update_transmitter_1_title" />

      <TextView
        style="@style/Text.Large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_standard"
        android:layout_marginBottom="@dimen/spacing_triple"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:textColor="@color/darkGrey03"
        android:text="@string/guide_update_transmitter_1_body" />

      <Button
        android:id="@+id/continue_button"
        style="@style/Button"
        android:layout_marginTop="@dimen/spacing_standard"
        android:layout_marginBottom="@dimen/spacing_standard"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:onClick="@{() -> controller.onContinueClicked()}"
        android:text="@string/generic_continue" />

      <Button
        android:id="@+id/button_discard"
        style="@style/Button.Secondary"
        android:layout_marginBottom="@dimen/spacing_standard"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:text="@string/onboarding_l6_button3"
        android:onClick="@{() -> controller.onDiscard()}"/>

    </LinearLayout>

  </androidx.constraintlayout.widget.ConstraintLayout>

</layout>