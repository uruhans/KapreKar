<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <import type="android.view.View" />

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.dialogs.PatchDialogController" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent_black"
    android:onClick="@{() -> controller.onDismissClicked()}">

    <androidx.cardview.widget.CardView
      android:id="@+id/cardView"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="30dp"
      android:layout_marginEnd="30dp"
      app:cardBackgroundColor="@color/cardview_background"
      app:cardCornerRadius="@dimen/cardview_corner_radius"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

          <ImageView
            android:id="@+id/button_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/spacing_standard"
            android:layout_marginEnd="@dimen/spacing_standard"
            android:foreground="?attr/actionBarItemBackground"
            android:onClick="@{() -> controller.onCloseClicked()}"
            android:src="@drawable/main_sidemenu_close" />

          <com.coloplast.olympus.ui.common.widgets.PatchView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/spacing_double"
            android:layout_marginBottom="@dimen/spacing_double"
            app:isDetailView="@{true}"
            app:patch="@{controller.currentPatch}" />

        </FrameLayout>

        <TextView
          style="@style/Text.Medium"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:layout_marginTop="@dimen/spacing_double"
          android:text="Leakage development"
          android:textColor="@color/text_dark_grey_03" />

        <TextView
          style="@style/Text.Large"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:layout_marginTop="@dimen/spacing_standard"
          android:text="First detection 18:55"
          android:textColor="@color/text_dark_grey_01" />

        <TextView
          style="@style/Text.Large"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:layout_marginTop="@dimen/spacing_quarter"
          android:layout_marginBottom="60dp"
          android:text="Second detection 18:55"
          android:textColor="@color/text_dark_grey_01" />

      </LinearLayout>
    </androidx.cardview.widget.CardView>

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>