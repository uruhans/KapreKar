<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>

    <import type="android.view.View" />

    <import type="com.coloplast.olympus.R" />

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.home.HomeController" />

  </data>

  <androidx.drawerlayout.widget.DrawerLayout
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/constraintLayout"
      android:layout_width="match_parent"
      android:layout_height="match_parent">

      <ImageView
        android:id="@+id/icon_bluetooth"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginTop="@dimen/spacing_standard"
        android:padding="2dp"
        android:src="@drawable/ic_bluetooth_black_24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tintDrawable="@{controller.isConnected() ? R.color.icon_enabled : R.color.icon_disabled}" />

      <com.coloplast.olympus.ui.common.widgets.ConnectionStateTextView
        android:id="@+id/connection_state_text"
        style="@style/Text.Large"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/spacing_half"
        android:gravity="center_vertical"
        android:textColor="@color/grey"
        app:animateText='@{controller.isConnected ? @string/status_connected : @string/status_disconnected}'
        app:layout_constraintBottom_toBottomOf="@+id/icon_bluetooth"
        app:layout_constraintStart_toEndOf="@+id/icon_bluetooth"
        app:layout_constraintTop_toTopOf="@+id/icon_bluetooth" />

      <ImageView
        android:id="@+id/menu_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="@dimen/spacing_standard"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:background="?attr/actionBarItemBackground"
        android:onClick="@{() -> controller.onMenuClicked()}"
        android:src="@drawable/ic_menu_24dp"
        android:tint="@color/darkgrey"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

      <com.coloplast.olympus.ui.common.widgets.PatchView
        android:id="@+id/icon_patch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        app:error="@{controller.patchInErrorState}"
        app:isDetailView="@{false}"
        app:layout_constraintBottom_toTopOf="@+id/content_container"
        app:layout_constraintStart_toStartOf="parent"
        app:listener="@{controller.patchClickedListener}"
        app:patch="@{controller.currentPatch}"
        app:rawRotationalAngle="@{controller.rawRotationAngle}"
        app:visibleOrGoneFade="@{controller.isPatchVisible}" />

      <com.bluelinelabs.conductor.ChangeHandlerFrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_standard"
        android:layout_marginBottom="@dimen/spacing_standard"
        app:layout_constraintBottom_toTopOf="@+id/power_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

      <ImageView
        android:id="@+id/power_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="@dimen/spacing_standard"
        app:layout_constraintBottom_toTopOf="@id/progress_animator"
        app:layout_constraintStart_toStartOf="@+id/icon_bluetooth"
        app:powerLevel="@{controller.powerLevel}"
        app:visibleOrInvisibleFade="@{controller.isConnected}" />

      <TextView
        android:id="@+id/lastcheck"
        style="@style/Text.Large"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:gravity="center_vertical"
        android:textColor="@color/grey"
        app:lastCheck="@{controller.lastCheck}"
        app:layout_constraintBottom_toBottomOf="@+id/power_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/power_icon"
        app:visibleOrInvisibleFade="@{controller.isConnected}"
        tools:text="@string/status_last_check" />

      <com.coloplast.olympus.ui.common.widgets.AnimatedProgressView
        android:id="@+id/progress_animator"
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:background="@color/progress_animation_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:update="@{controller.updateAnimation}"
        app:visibleOrInvisibleFade="@{controller.isConnected}" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
      android:id="@+id/nav_view"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_gravity="end"
      android:fitsSystemWindows="true">

      <include layout="@layout/view_sidemenu" app:controller="@{controller}" />

    </com.google.android.material.navigation.NavigationView>

  </androidx.drawerlayout.widget.DrawerLayout>
</layout>