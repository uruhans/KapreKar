<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.common.dialogs.DialogController" />

  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent_black"
    android:onClick="@{() -> controller.onDismissClicked()}">

    <androidx.cardview.widget.CardView
      android:id="@+id/cardView"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="40dp"
      android:layout_marginEnd="40dp"
      app:cardBackgroundColor="@color/cardview_background"
      app:cardCornerRadius="@dimen/cardview_corner_radius"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent">

      <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <TextView
          android:id="@+id/title"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/dialog_text_margin"
          android:layout_marginTop="@dimen/dialog_text_margin"
          android:layout_marginEnd="@dimen/dialog_text_margin"
          android:ellipsize="end"
          android:maxLines="2"
          android:textColor="@color/text_black"
          android:textSize="20sp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:safeText="@{controller.titleId}"
          tools:text="Dialog title text" />

        <TextView
          android:id="@+id/message"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/dialog_text_margin"
          android:layout_marginTop="@dimen/spacing_half"
          android:layout_marginEnd="@dimen/dialog_text_margin"
          android:textColor="@color/text_gray"
          android:textSize="16sp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/title"
          app:safeText="@{controller.messageId}"
          tools:text="Dialog message text is a lot longer than the title because we want to display a long text to the user that could contain anything at all" />

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/spacing_standard"
          android:orientation="horizontal"
          android:padding="@dimen/dialog_button_padding"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/message">

          <Button
            android:id="@+id/button_negative"
            style="@style/Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:onClick="@{() -> controller.onNegativeButtonClicked()}"
            android:paddingLeft="@dimen/dialog_button_padding"
            android:paddingRight="@dimen/dialog_button_padding"
            android:textAllCaps="true"
            app:visibleOrInvisible="@{controller.negativeButtonTextId > 0}"
            app:safeText="@{controller.negativeButtonTextId}"
            tools:text="negative" />

          <Button
            android:id="@+id/button_neutral"
            style="@style/Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:onClick="@{() -> controller.onNeutralButtonClicked()}"
            android:paddingLeft="@dimen/dialog_button_padding"
            android:paddingRight="@dimen/dialog_button_padding"
            android:textAllCaps="true"
            app:safeText="@{controller.neutralButtonTextId}"
            app:visibleOrInvisible="@{controller.neutralButtonTextId > 0}"
            tools:text="neutral" />

          <Button
            android:id="@+id/button_positive"
            style="@style/Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:onClick="@{() -> controller.onPositiveButtonClicked()}"
            android:paddingLeft="@dimen/dialog_button_padding"
            android:paddingRight="@dimen/dialog_button_padding"
            android:textAllCaps="true"
            app:safeText="@{controller.positiveButtonTextId}"
            tools:text="positive" />

        </LinearLayout>

      </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>