<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.common.BaseFlowController" />

  </data>

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
      android:id="@+id/toolbar_content_layout"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center">

      <ImageView
        android:id="@+id/navigation_icon"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="?actionBarItemBackground"
        android:onClick="@{() -> controller.onNavigationButtonClicked()}"
        android:paddingStart="@dimen/spacing_standard"
        android:paddingEnd="@dimen/spacing_standard"
        android:scaleType="center"
        android:src="@drawable/ic_close"
        android:tint="@color/colorAccent" />

      <TextView
        android:id="@+id/title"
        style="@style/ToolbarText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        app:animateText="@{controller.title}"
        tools:text="Toolbar" />

      <ImageView
        android:id="@+id/submit_button"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="?actionBarItemBackground"
        android:onClick="@{() -> controller.onSubmitClicked()}"
        android:paddingStart="@dimen/spacing_standard"
        android:paddingEnd="@dimen/spacing_standard"
        android:scaleType="center"
        android:src="@drawable/ic_check_black_24dp"
        android:tint="@color/colorAccent"
        app:visibleOrGone="@{controller.showSubmitButton}" />

    </LinearLayout>

    <ProgressBar
      style="@android:style/Widget.ProgressBar.Horizontal"
      android:layout_width="match_parent"
      android:layout_height="2dp"
      android:layout_gravity="bottom"
      android:backgroundTint="@color/white"
      android:max="@{controller.progressMax}"
      android:progressDrawable="@drawable/gradient_progress"
      app:visibleOrGone="@{controller.showProgress}"
      app:animateProgress="@{controller.progress}" />

  </FrameLayout>


</layout>