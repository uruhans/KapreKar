<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>

    <variable
      name="toolbarSupport"
      type="com.coloplast.olympus.ui.common.ToolbarSupportController" />

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.transmitters.TransmittersController" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <include
      android:id="@+id/toolbar"
      layout="@layout/view_toolbar"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:support="@{toolbarSupport}" />

    <TextView
      android:id="@+id/headline"
      style="@style/TextStyle.Coloplast.Bold.DarkGrey.32"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:text="@string/transmitters_title"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <TextView
      android:id="@+id/button_edit"
      style="@style/TextStyle.Roboto.Medium.Turquoise.18"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:text="@string/transmitters_edit"
      app:layout_constraintBottom_toBottomOf="@+id/headline"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="@+id/headline"
      app:visibleOrInvisible="@{controller.hasTransmittersAdded}" />

    <include
      layout="@layout/state_no_transmitters"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:visibility="gone"
      app:controller="@{controller}"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/headline"
      app:visibleOrGone="@{!controller.hasTransmittersAdded}" />

    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/layout_transmitters_added"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:orientation="vertical"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/headline"
      app:visibleOrGone="@{controller.hasTransmittersAdded}"
      tools:visibility="visible">

      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_standard"
        android:background="@color/white"
        app:itemBinding="@{controller.itemBinding}"
        app:items="@{controller.items}"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

      <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginBottom="78dp"
        android:background="#f5f5f5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

      <FrameLayout
        android:id="@+id/floating_action_button"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
          android:id="@+id/imageView"
          android:layout_width="110dp"
          android:layout_height="110dp"
          android:alpha="0.16"
          android:padding="@dimen/spacing_standard"
          android:scaleX="0.7"
          android:scaleY="0.7"
          android:src="@drawable/transmitter_fab"
          app:visibleOrGone="@{controller.retryPressed}"
          app:startScaleAnimation="@{controller.retryPressed}" />

        <androidx.cardview.widget.CardView
          android:layout_width="56dp"
          android:layout_height="56dp"
          android:layout_gravity="center"
          android:backgroundTint="@color/white"
          android:enabled="@{controller.searchEnabled}"
          android:foreground="?attr/selectableItemBackgroundBorderless"
          android:onClick="@{() -> controller.onSearchClicked()}"
          app:cardCornerRadius="200dp"
          app:cardElevation="4dp"
          app:visibleOrGone="@{true}">

          <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:tint="@color/turquoise"
            app:srcCompat="@drawable/ic_bluetooth" />

        </androidx.cardview.widget.CardView>
      </FrameLayout>

      <TextView
        android:id="@+id/bluetooth_status"
        style="@style/TextStyle.Coloplast.Regular.ClearGrey.16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginBottom="16dp"
        android:text="@string/transmitters_searching"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:visibleOrInvisible="@{controller.retryPressed}" />

      <TextView
        android:id="@+id/button_add"
        style="@style/TextStyle.Roboto.Medium.Turquoise.18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:onClick="@{() -> controller.onAddTransmitterClicked()}"
        android:text="@string/transmitters_add_transmitter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:visibleOrInvisible="@{controller.canAddMoreTransmitters}" />

    </androidx.constraintlayout.widget.ConstraintLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
