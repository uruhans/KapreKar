<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <import type="com.coloplast.olympus.R" />

    <variable
      name="toolbarSupport"
      type="com.coloplast.olympus.ui.common.ToolbarSupportController" />

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.onboarding.login.LoginController" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_background">

    <include
      android:id="@+id/toolbar"
      layout="@layout/view_toolbar"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:support="@{toolbarSupport}" />

    <TextView
      android:id="@+id/title"
      style="@style/TextStyle.Coloplast.Bold.DarkGrey.32"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_margin="@dimen/spacing_larger"
      android:text="@string/onboarding_login_title"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <TextView
      android:id="@+id/description"
      style="@style/TextStyle.Roboto.Regular.ClearGrey.30"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_larger"
      android:layout_marginTop="@dimen/spacing_half"
      android:layout_marginEnd="@dimen/spacing_larger"
      android:layout_marginBottom="@dimen/spacing_larger"
      android:text="@string/onboarding_login_description"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/title" />

    <TextView
      android:id="@+id/email_field"
      style="@style/TextStyle.Roboto.Regular.ClearGrey.14"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_larger"
      android:layout_marginTop="@dimen/spacing_triple"
      android:layout_marginEnd="@dimen/spacing_larger"
      android:text="@string/onboarding_email_address"
      app:layout_constraintTop_toBottomOf="@id/description" />

    <com.coloplast.olympus.ui.common.widgets.EmailView
      android:id="@+id/email_input"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_half"
      android:layout_marginEnd="@dimen/spacing_half"
      app:checkValidity="@{true}"
      app:emailCallback="@{controller.onCurrentEmailChanged}"
      app:forceValidation="@{controller.fieldsValidationTrigger}"
      app:layout_constraintTop_toBottomOf="@id/email_field"
      app:onValidityChanged="@{controller.onEmailValidityChanged}" />

    <TextView
      android:id="@+id/password_description"
      style="@style/TextStyle.Roboto.Regular.ClearGrey.14"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_larger"
      android:layout_marginTop="@dimen/spacing_large"
      android:layout_marginEnd="@dimen/spacing_larger"
      android:text="@string/onboarding_password_title"
      app:layout_constraintTop_toBottomOf="@id/email_input" />

    <com.coloplast.olympus.ui.common.widgets.PasswordView
      android:id="@+id/password_input"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_half"
      android:layout_marginEnd="@dimen/spacing_half"
      app:checkValidity="@{true}"
      app:forceValidation="@{controller.fieldsValidationTrigger}"
      app:hint="@{R.string.onboarding_password_title}"
      app:layout_constraintTop_toBottomOf="@id/password_description"
      app:onValidityChanged="@{controller.onPasswordValidityChanged}"
      app:passwordCallback="@{controller.onCurrentPasswordChanged}" />

    <Button
      style="@style/TextStyle.Roboto.Medium.Turquoise.16"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_larger"
      android:layout_marginEnd="@dimen/spacing_larger"
      android:background="?attr/selectableItemBackground"
      android:onClick="@{() -> controller.onForgotPassword()}"
      android:text="@string/onboarding_forgot_password"
      android:textAlignment="textStart"
      app:layout_constraintTop_toBottomOf="@id/password_input" />


    <Button
      style="@style/Button"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:onClick="@{() -> controller.onNextClicked() }"
      android:text="@string/onboarding_login_button"
      app:layout_constraintBottom_toBottomOf="parent" />

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>