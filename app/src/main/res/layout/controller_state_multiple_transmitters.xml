<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>
    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.uistates.MultipleTransmittersController" />
  </data>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="bottom"
    android:orientation="vertical">

    <TextView
      style="@style/Headline.Large"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginTop="@dimen/spacing_half"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:text="@string/status_multiple_transmitters_title" />

    <TextView
      style="@style/Headline.Large"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:layout_marginBottom="@dimen/spacing_double"
      android:fontFamily="@font/coloplast"
      android:text="@string/status_multiple_transmitters"
      android:textColor="@color/grey" />

    <include layout="@layout/item_app_guide_button"
      android:id="@+id/includeBtn"
      app:visibleOrGone="@{controller.shouldShowAppTourButton}"
      app:buttonClickListener="@{() -> controller.onAppTourClicked()}"/>

  </LinearLayout>
</layout>