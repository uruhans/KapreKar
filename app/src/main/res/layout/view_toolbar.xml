<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <import type="android.view.View" />

    <variable
      name="support"
      type="com.coloplast.olympus.ui.common.ToolbarSupportController" />

  </data>

  <androidx.appcompat.widget.Toolbar
    style="@style/Toolbar"
    app:contentInsetEnd="0dp"
    app:contentInsetStart="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/toolbar_content_layout"
      android:layout_width="match_parent"
      android:layout_height="@dimen/toolbar_height"
      android:clipToPadding="false"
      android:padding="@dimen/spacing_standard">

      <ImageView
        android:id="@+id/button_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:foreground="?attr/actionBarItemBackground"
        android:onClick="@{() -> support.onBackClicked()}"
        android:paddingEnd="2dp"
        android:scaleX="-1"
        android:src="@drawable/ic_arrow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:visibleOrGone="@{support.showBackButton}" />

      <ImageView
        android:id="@+id/button_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="?attr/actionBarItemBackground"
        android:onClick="@{() -> support.onCloseClicked()}"
        android:src="@drawable/main_sidemenu_close"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:visibleOrGone="@{support.showCloseButton}" />

    </androidx.constraintlayout.widget.ConstraintLayout>

  </androidx.appcompat.widget.Toolbar>
</layout>