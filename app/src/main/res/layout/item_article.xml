<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>
    <import type="android.view.View" />
    <variable
      name="item"
      type="com.coloplast.olympus.ui.feature.guides.getstarted.model.ArticleItem" />
  </data>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
      android:id="@+id/article_image"
      android:layout_width="match_parent"
      android:layout_height="250dp"
      android:layout_marginTop="@dimen/spacing_double"
      app:resource="@{item.image}"
      android:visibility="@{item.showImage ? View.VISIBLE : View.GONE}"
      tools:src="@drawable/guide_get_started_1"
      android:scaleType="centerInside"
      tools:visibility="gone"/>

    <TextView
      android:id="@+id/article_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      style="@style/GuideHeader.20"
      android:layout_marginTop="@dimen/spacing_small"
      android:layout_marginBottom="@dimen/spacing_small"
      app:safeText="@{item.title}"
      android:visibility="@{item.showTitle ? View.VISIBLE : View.GONE}"
      tools:text="@string/guide_get_started_1_text"
      tools:visibility="gone"/>

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:safeText="@{item.description}"
      android:layout_marginBottom="@dimen/spacing_small"
      android:visibility="@{item.showDescription ? View.VISIBLE : View.GONE}"
      style="@style/GuideSubTitle"
      tools:text="@string/guide_get_started_sub_title_1"
      tools:visibility="gone"/>

  </LinearLayout>
</layout>