<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.update.progress.FirmwareProgressController" />

  </data>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_background"
    android:gravity="center"
    android:orientation="vertical">

    <com.google.android.material.progressindicator.ProgressIndicator
      style="@style/Widget.MaterialComponents.ProgressIndicator.Linear.Determinate"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_double"
      android:layout_marginEnd="@dimen/spacing_double"
      android:progress="@{controller.currentProgress}"
      app:indicatorColor="@color/turquoise"
      app:indicatorCornerRadius="20dp"
      app:indicatorType="linear"
      app:indicatorWidth="10dp"
      app:trackColor="#dbdbdb" />

    <TextView
      android:id="@+id/title"
      style="@style/GuideHeader.24"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_horizontal"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginTop="@dimen/spacing_triple"
      android:layout_marginEnd="@dimen/spacing_standard"
      tools:text="@string/guide_update_transmitter_3_title1"
      app:safeText="@{controller.titleRes}" />

    <TextView
      style="@style/TextStyle.Roboto.Regular.ClearGrey.18"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_double"
      android:layout_marginTop="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_double"
      android:gravity="center"
      android:lineSpacingExtra="5dp"
      android:text="@string/guide_update_transmitter_3_body" />

  </LinearLayout>
</layout>