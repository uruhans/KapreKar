<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">
  <data>
    <variable
      name="item"
      type="com.coloplast.olympus.ui.feature.guides.getstarted.model.HeaderItem" />
  </data>

<androidx.constraintlayout.widget.ConstraintLayout
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  >

  <ImageView
    android:id="@+id/iv_icon"
    android:layout_width="37dp"
    android:layout_height="40dp"
    android:layout_marginTop="@dimen/spacing_half"
    android:scaleType="fitXY"
    android:src="@drawable/ic_baseline_list_alt_24"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent" />

  <TextView
    android:id="@+id/guide_get_started_header"
    style="@style/GuideHeader.32"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_large"
    app:safeText="@{item.header}"
    tools:text="@string/guide_get_started_title"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/iv_icon" />

  <TextView
    android:id="@+id/guide_get_started_description"
    style="@style/GuideHeaderDescription"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_half"
    android:layout_marginBottom="@dimen/spacing_standard"
    app:safeText="@{item.subHeader}"
    tools:text="@string/guide_get_started_sub_title_1"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/guide_get_started_header" />

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>