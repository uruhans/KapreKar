<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">
  <data>
    <variable
      name="item"
      type="com.coloplast.olympus.ui.feature.guide.model.HeaderItem" />
  </data>

<androidx.constraintlayout.widget.ConstraintLayout
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@color/white">

  <ImageView
    android:id="@+id/iv_icon"
    android:layout_width="37dp"
    android:layout_height="40dp"
    android:layout_marginStart="16dp"
    android:layout_marginTop="8dp"
    android:scaleType="fitXY"
    android:src="@drawable/ic_baseline_list_alt_24"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent" />

  <TextView
    android:id="@+id/guide_get_started_header"
    style="@style/Headline.Large"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_standard"
    android:layout_marginTop="24dp"
    android:text="@string/guide_get_started_title"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/iv_icon" />

  <TextView
    android:id="@+id/guide_get_started_description"
    style="@style/Headline.Medium"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_standard"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="16dp"
    android:text="@string/guide_get_started_sub_title_1"
    android:textColor="#8C918F"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/guide_get_started_header"
    app:layout_constraintVertical_bias="0.07" />

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>