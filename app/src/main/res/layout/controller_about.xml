<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <variable
      name="toolbarSupport"
      type="com.coloplast.olympus.ui.common.ToolbarSupportController" />

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.about.AboutController" />
  </data>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
      android:id="@+id/toolbar"
      layout="@layout/view_toolbar"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:support="@{toolbarSupport}" />

    <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_larger"
        android:layout_marginEnd="@dimen/spacing_larger"
        android:orientation="vertical">

        <TextView
          style="@style/TextStyle.Coloplast.Bold.DarkGrey.32"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/about_ap_title" />

        <TextView
          style="@style/TextStyle.Coloplast.Bold.DarkGrey.20"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/spacing_triple"
          android:text="@string/about_ap_section1_header" />

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/about_ap_section1_description"
          android:layout_marginTop="@dimen/spacing_small" />

        <Button
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/about_ap_section1_link_text"
          style="@style/Button.Borderless"
          android:textAlignment="textStart"
          android:textAllCaps="false"
          android:onClick="@{() -> controller.onLinkOneClicked()}"/>

        <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginTop="@dimen/spacing_double"
          android:background="@color/patch_grey" />

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/spacing_double"
          android:text="@string/about_ap_section2_header"
          style="@style/TextStyle.Coloplast.Bold.DarkGrey.20" />

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/spacing_small"
          android:text="@string/about_ap_section2_description"
          style="@style/TextStyle.Roboto.Regular.ClearGrey.16" />

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/spacing_larger"
          android:text="@string/about_ap_section2_subsection1_header"
          style="@style/TextStyle.Coloplast.Bold.DarkGrey.16" />

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/spacing_small"
          android:text="@string/about_ap_section2_subsection1_description"
          style="@style/TextStyle.Roboto.Regular.ClearGrey.16" />

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/spacing_larger"
          android:text="@string/about_ap_section2_subsection1_header"
          style="@style/TextStyle.Coloplast.Bold.DarkGrey.16" />

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/spacing_small"
          android:text="@string/about_ap_section2_subsection1_description"
          style="@style/TextStyle.Roboto.Regular.ClearGrey.16" />

        <Button
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/about_ap_section2_link_text"
          style="@style/Button.Borderless"
          android:textAlignment="textStart"
          android:textAllCaps="false"
          android:onClick="@{() -> controller.onLinkTwoClicked()}"/>

      </LinearLayout>

    </ScrollView>

  </LinearLayout>
</layout>