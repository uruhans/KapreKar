<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>

    <import type="com.coloplast.olympus.R" />

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.common.InfoPageController" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
      android:id="@+id/linearLayout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:orientation="vertical"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_bias="1">

      <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="@dimen/spacing_standard"
        android:layout_marginEnd="@dimen/spacing_standard"
        app:resource="@{controller.iconId}"
        app:tintDrawable="@{R.color.turquoise}"
        tools:src="@drawable/ic_info_circle" />

      <TextView
        style="@style/TextStyle.Coloplast.Bold.DarkGrey.24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginTop="@dimen/spacing_large"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:text="@{controller.titleId}"
        tools:text="@string/onboarding_chapter_preparing_change_title" />

      <TextView
        android:id="@+id/title"
        style="@style/TextStyle.Roboto.Regular.ClearGrey.18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginTop="@dimen/spacing_standard"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:lineSpacingMultiplier="1.2"
        android:text="@{controller.descriptionId}"
        tools:text="@string/onboarding_chapter_preparing_change_description" />

      <Button
        android:id="@+id/accept_button"
        style="@style/Button"
        android:layout_marginTop="@dimen/spacing_quadruple"
        android:layout_marginBottom="@dimen/spacing_standard"
        android:onClick="@{() -> controller.onPositiveButtonClicked()}"
        android:text="@{controller.positiveButtonTextId}" />

      <TextView

        style="@style/TextStyle.Roboto.Medium.Turquoise"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_standard"
        android:gravity="center"
        android:onClick="@{() -> controller.onNegativeButtonClicked()}"
        app:visibleOrGone="@{controller.showNegativeButton}"
        app:safeText="@{controller.negativeButtonTextId}" />

    </LinearLayout>


  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>