<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.welcome.WelcomeController" />

  </data>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="bottom"
    android:orientation="vertical">

    <TextView
      style="@style/Headline.Large"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginTop="@dimen/spacing_half"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:text="@string/onboarding_login_title" />

    <TextView
      style="@style/Headline.Large"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:layout_marginBottom="@dimen/spacing_double"
      android:fontFamily="@font/coloplast"
      android:singleLine="true"
      android:text="@string/guide_ap2_subtitle"
      android:textColor="@color/grey" />

    <androidx.cardview.widget.CardView
      android:id="@+id/app_tour"
      android:layout_width="match_parent"
      android:layout_height="@dimen/cardview_button_height_default"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:layout_marginBottom="@dimen/spacing_double"
      android:foreground="?attr/selectableItemBackground"
      android:onClick="@{() -> controller.onAppTourClicked()}"
      app:cardBackgroundColor="@color/white"
      app:cardCornerRadius="28dp"
      app:cardElevation="4dp"
      app:cardPreventCornerOverlap="true"
      app:cardUseCompatPadding="false">

      <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_icon_guides"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/spacing_large"/>

      <TextView
        style="@style/Text.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/guide_ap1_title"
        android:textSize="18sp" />

    </androidx.cardview.widget.CardView>

  </LinearLayout>
</layout>