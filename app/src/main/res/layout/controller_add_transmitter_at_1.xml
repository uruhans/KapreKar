<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.transmitters.add.at1.AddTransmitterAT1Controller" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/top"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ImageView
      android:id="@+id/imageView2"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginBottom="@dimen/spacing_larger"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_icon_guides"
      app:layout_constraintBottom_toTopOf="@+id/transmitter_guide_at1_title"
      app:layout_constraintStart_toStartOf="parent" />

    <TextView
      android:id="@+id/transmitter_guide_at1_title"
      style="@style/GuideHeader.32"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:layout_marginBottom="@dimen/spacing_half"
      android:text="@string/guide_at1_title"
      app:layout_constraintBottom_toTopOf="@+id/application_guide_description"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent" />

    <TextView
      android:id="@+id/application_guide_description"
      style="@style/GuideHeaderDescription"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:layout_marginBottom="@dimen/spacing_quadruple"
      android:text="@string/guide_at1_body"
      app:layout_constraintBottom_toTopOf="@+id/accept_button"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent" />


    <Button
      android:id="@+id/accept_button"
      android:layout_width="match_parent"
      android:layout_height="@dimen/cardview_button_height_default"
      android:layout_marginStart="@dimen/spacing_standard"
      android:layout_marginEnd="@dimen/spacing_standard"
      android:layout_marginBottom="@dimen/spacing_double"
      android:background="@drawable/button_color_accent"
      android:onClick="@{() -> controller.onNextClicked()}"
      android:text="@string/guide_at1_action"
      android:textAllCaps="false"
      android:textColor="@color/white"
      android:textSize="@dimen/text_18"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent" />


  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
