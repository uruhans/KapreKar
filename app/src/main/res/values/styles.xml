  <style name="Button">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">@dimen/cardview_button_height_default</item>
    <item name="android:layout_marginStart">@dimen/spacing_standard</item>
    <item name="android:layout_marginEnd">@dimen/spacing_standard</item>
    <item name="android:layout_marginBottom">@dimen/spacing_double</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:background">@drawable/button_color_accent</item>
    <item name="android:textColor">@color/white</item>
    <item name="android:textSize">@dimen/text_18</item>
  </style>

  <style name="Button.Secondary" parent="Button">
    <item name="android:background">@drawable/button_submit</item>
    <item name="android:textColor">@color/black</item>
  </style>

  <style name="Button.Selectable">
