<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

  <LinearLayout
    android:id="@+id/innerleak_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="bottom"
    android:paddingStart="@dimen/spacing_standard"
    android:paddingEnd="@dimen/spacing_standard"
    android:orientation="vertical">

    <TextView
      style="@style/Headline.Large"
      android:transitionName="test"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/status_inner_breach_title" />

    <TextView
      style="@style/Headline.Large"
      android:transitionName="test"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="@font/coloplast"
      android:text="@string/status_inner_breach"
      android:textColor="@color/grey" />

  </LinearLayout>
</layout>