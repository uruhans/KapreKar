<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>
    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.home.HomeController" />

  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/spacing_double">


    <LinearLayout
      android:id="@+id/get_started_layout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="50dp"
      android:onClick="@{() -> controller.onButtonGetStartedGuideClick()}"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent">

      <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_double"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/ic_icon_guides" />

      <TextView
        style="@style/Headline.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:text="@string/guide_get_started" />

    </LinearLayout>
    <LinearLayout
      android:id="@+id/chargin_guide_layout"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="@dimen/spacing_standard"
      android:onClick="@{() -> controller.onButtonChargingGuideClick()}"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/get_started_layout">

      <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/spacing_double"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/ic_baseline_list_alt_24" />

      <TextView
        style="@style/Headline.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:text="@string/guide_charge" />

    </LinearLayout>
    <LinearLayout
      android:id="@+id/application_guide_layout"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="@dimen/spacing_standard"
      android:onClick="@{() -> controller.onButtonApplicationGuideClick()}"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/chargin_guide_layout">

      <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_double"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/ic_icon_guides" />

      <TextView
        style="@style/Headline.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:text="@string/guide_change_plate" />

    </LinearLayout>




  </androidx.constraintlayout.widget.ConstraintLayout>

</layout>