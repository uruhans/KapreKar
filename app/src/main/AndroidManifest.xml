<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.coloplast.olympus">

  <uses-permission android:name="android.permission.BLUETOOTH" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.INTERNET" />

  <uses-feature
    android:name="android.hardware.bluetooth_le"
    android:required="true" />

  <application
    android:name=".CustomApplication"
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/launch_screen_title"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/AppTheme">
    <activity android:name=".activities.MainActivity" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- a receiver for local notifications when a user snooze their notification -->
    <receiver
      android:name=".notifications.NotificationBroadcastReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="${applicationId}.NOTIFICATION_ACTION_SNOOZE" />
        <action android:name="${applicationId}.NOTIFICATION_SHOW" />
      </intent-filter>
    </receiver>

    <receiver
      android:name=".bluetooth.service.ResetReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="${applicationId}.BLUETOOTH.RESET_SERVICE" />
      </intent-filter>
    </receiver>

    <service android:name=".bluetooth.service.BluetoothConnectionService" />
  </application>

</manifest>