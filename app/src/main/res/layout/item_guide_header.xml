<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">

  <data>

    <variable
      name="item"
      type="com.coloplast.olympus.ui.feature.guides.models.HeaderItem" />
  </data>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_standard"
    android:paddingEnd="@dimen/spacing_standard">

    <ImageView
      android:id="@+id/iv_icon"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:layout_marginTop="@dimen/spacing_half"
      android:scaleType="fitXY"
      android:src="@drawable/ic_icon_guides" />

    <TextView
      android:id="@+id/guide_get_started_header"
      style="@style/GuideHeader.32"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/spacing_large"
      app:safeText="@{item.header}"
      app:visibleOrGone="@{item.showHeader}"
      tools:text="@string/guide_get_started_title" />

    <TextView
      android:id="@+id/guide_get_started_description"
      style="@style/GuideHeaderDescription"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/spacing_half"
      android:layout_marginBottom="@dimen/spacing_standard"
      app:safeText="@{item.subHeader}"
      app:visibleOrGone="@{item.showSubHeader}"
      tools:text="@string/guide_get_started_sub_title_1" />

  </LinearLayout>
</layout>