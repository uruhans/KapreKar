<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>
    <import type="android.view.View" />
    <import type="com.coloplast.olympus.R" />

    <variable
      name="controller"
      type="com.coloplast.olympus.ui.feature.onboarding.login.LoginController" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/toolbar_height">

    <TextView
      android:id="@+id/title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_margin="@dimen/spacing_larger"
      android:text="@string/onboarding_login_title"
      style="@style/TextStyle.Coloplast.Bold.DarkGrey.24"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/spacing_larger"
      android:text="@string/onboarding_login_description"
      style="@style/TextStyle.Roboto.Regular.ClearGrey.18"
      app:layout_constraintStart_toStartOf="@id/title"
      app:layout_constraintTop_toBottomOf="@id/title" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:layout_marginTop="@dimen/spacing_half"
      android:layout_marginBottom="@dimen/spacing_double"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_email_title"
        style="@style/TextStyle.Roboto.Regular.ClearGrey.14"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginTop="@dimen/spacing_half"
        android:layout_marginEnd="@dimen/spacing_standard" />

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/email_input_layout"
        style="@style/TextInputLayoutAppearance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginTop="@dimen/spacing_half"
        android:layout_marginEnd="@dimen/spacing_standard">
        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/email_edittext"
          style="@style/EditTextInputText"
          android:hint="@string/onboarding_email_hint"
          app:errorBackground="@{controller.validEmail}"
          android:text="@={controller.email}"
          android:inputType="textEmailAddress"/>
      </com.google.android.material.textfield.TextInputLayout>

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:text="@string/onboarding_email_error"
        style="@style/TextInputLayoutErrorText"
        app:visibleOrGone="@{!controller.validEmail}"/>

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_password_title"
        style="@style/TextStyle.Roboto.Regular.ClearGrey.14"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginTop="@dimen/spacing_large"
        android:layout_marginEnd="@dimen/spacing_standard" />

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/password_input_layout"
        style="@style/TextInputLayoutAppearance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginTop="@dimen/spacing_half"
        android:layout_marginEnd="@dimen/spacing_standard">
        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/password_edittext"
          style="@style/EditTextInputText"
          android:background="@drawable/edittext_background"
          android:hint="@string/onboarding_password_hint"
          app:errorBackground="@{controller.validPassword}"
          android:text="@={controller.password}"
          android:inputType="textPassword"
          app:onSubmit="@{() -> controller.onNextClicked()}"/>
      </com.google.android.material.textfield.TextInputLayout>

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:text="@string/onboarding_password_error"
        style="@style/TextInputLayoutErrorText"
        visibleOrGone="@{!controller.validPassword}" />

      <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_half"
        android:layout_marginStart="@dimen/spacing_half"
        android:layout_marginEnd="@dimen/spacing_half"
        android:text="@string/onboarding_forgot_password"
        android:textAlignment="textStart"
        android:background="?attr/selectableItemBackground"
        style="@style/TextStyle.Roboto.Medium.Turquoise.16"
        android:onClick="@{() -> controller.onForgotPassword()}"/>


    </LinearLayout>

    <Button
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/onboarding_login_button"
      style="@style/Button"
      android:onClick="@{() -> controller.onNextClicked() }"
      app:layout_constraintBottom_toBottomOf="parent" />

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>